<Window x:Class="UPETAcqLab.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UPET AcqLab Admin — chei aplicație"
        Width="1100" Height="680"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="480">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="UPET AcqLab — Administrare chei" FontSize="22" FontWeight="SemiBold" Foreground="#0072C6"/>
      <TextBlock Text="drd. ing. Iucal Ilie / Universitatea din Petroșani — panou separat (nu Canale DAQ)"
                 Foreground="#555555" Margin="0,2,0,12"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#555555" FontSize="11" Margin="0,10,0,0"
               Text="GDPR: adresa IP este înregistrată exclusiv pentru auditul licențelor pe PC-urile de laborator."/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#E8ECF0" Padding="12" Margin="0,0,0,10" BorderBrush="#9AA3AD" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="URL server:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="UrlBox" MinWidth="280" Width="340"/>
            <TextBlock Text="Parolă admin:" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <PasswordBox x:Name="PasswordBox" Width="180"/>
            <Button x:Name="ConnectButton" Content="Conectează" Click="Connect_Click"/>
          </StackPanel>
          <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" TextWrapping="Wrap"
                     Foreground="#555555" Text="Introduceți parola locală (nu se salvează pe GitHub) și conectați-vă la API."/>
          <Border Grid.Column="2" Background="#0072C6" Padding="14,8" CornerRadius="4" VerticalAlignment="Center">
            <TextBlock x:Name="CountText" Foreground="White" FontWeight="Bold" FontSize="16" Text="0 instalări"/>
          </Border>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
        <Button x:Name="GenerateButton" Content="Generează cheie" Click="Generate_Click" IsEnabled="False"/>
        <Button x:Name="RefreshButton" Content="Reîncarcă" Click="Refresh_Click" IsEnabled="False"
                Background="#6E7780"/>
      </StackPanel>

      <DataGrid x:Name="GridActivations" Grid.Row="2">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Cheie (mascată)" Binding="{Binding KeyMasked}" Width="220"/>
          <DataGridTextColumn Header="IP" Binding="{Binding RemoteIp}" Width="140"/>
          <DataGridTextColumn Header="Nume PC" Binding="{Binding Hostname}" Width="160"/>
          <DataGridTextColumn Header="Prima activare" Binding="{Binding FirstSeenLocal}" Width="140"/>
          <DataGridTextColumn Header="Ultima activare" Binding="{Binding LastSeenLocal}" Width="140"/>
          <DataGridTextColumn Header="Stare" Binding="{Binding StatusRo}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
