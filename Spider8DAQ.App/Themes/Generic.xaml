<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Spider8DAQ.App.Controls">
  <Style TargetType="{x:Type ctrl:MovableResizableCard}">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushUi}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrl:MovableResizableCard}">
          <Grid SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2">
              <DockPanel>
                <Border x:Name="PART_DragHeader"
                        DockPanel.Dock="Top"
                        Background="{DynamicResource CardHeaderBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="2,2,0,0"
                        Padding="6,4"
                        Cursor="SizeAll"
                        ToolTip="Trage titlul pentru a muta cardul">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HeaderBackground, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                          <Setter Property="Background" Value="{DynamicResource CardHeaderBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel>
                    <Button x:Name="PART_MinimizeButton"
                            DockPanel.Dock="Left"
                            Width="22" Height="20"
                            Margin="0,0,6,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Focusable="False"
                            Cursor="Hand"
                            ClickMode="Press"
                            ToolTip="Minimizează pe bara de jos"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource HairlineBrush}">
                      <TextBlock x:Name="PART_MinimizeGlyph"
                                 Text="―"
                                 FontSize="11"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"
                                 IsHitTestVisible="False"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Right"
                               Text="mută · redim."
                               FontSize="9"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                    <TextBlock x:Name="PART_Title"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{TemplateBinding Foreground}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </Border>
                <ContentPresenter x:Name="PART_ContentHost"
                                  Margin="6,6,6,6"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
              </DockPanel>
            </Border>

            <Thumb x:Name="PART_ResizeN"  Height="6" VerticalAlignment="Top"    HorizontalAlignment="Stretch" Margin="10,0,10,0" Cursor="SizeNS" Opacity="0.01"/>
            <Thumb x:Name="PART_ResizeS"  Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="10,0,10,0" Cursor="SizeNS" Opacity="0.01"/>
            <Thumb x:Name="PART_ResizeW"  Width="6"  VerticalAlignment="Stretch" HorizontalAlignment="Left"  Margin="0,10,0,10" Cursor="SizeWE" Opacity="0.01"/>
            <Thumb x:Name="PART_ResizeE"  Width="6"  VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="0,10,0,10" Cursor="SizeWE" Opacity="0.01"/>
            <Thumb x:Name="PART_ResizeNW" Width="12" Height="12" VerticalAlignment="Top"    HorizontalAlignment="Left"  Cursor="SizeNWSE" Opacity="0.01"/>
            <Thumb x:Name="PART_ResizeNE" Width="12" Height="12" VerticalAlignment="Top"    HorizontalAlignment="Right" Cursor="SizeNESW" Opacity="0.01"/>
            <Thumb x:Name="PART_ResizeSW" Width="12" Height="12" VerticalAlignment="Bottom" HorizontalAlignment="Left"  Cursor="SizeNESW" Opacity="0.01"/>
            <Thumb x:Name="PART_ResizeSE" Width="14" Height="14" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="SizeNWSE"
                   ToolTip="Trage colțul pentru a redimensiona">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent">
                    <Path Data="M0,10 L10,10 L10,0" Stroke="#8A9AAB" StrokeThickness="1.5"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"/>
                  </Grid>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
