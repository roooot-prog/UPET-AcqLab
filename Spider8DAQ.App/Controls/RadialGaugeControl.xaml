<UserControl x:Class="Spider8DAQ.App.Controls.RadialGaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="120" MinHeight="140"
             ClipToBounds="False"
             Background="Transparent"
             Cursor="Hand"
             ToolTip="Click pe cadran: setări scară, canal, unitate N/kN">
  <!-- Dial + digital readout below the cadran (outside the arc), centered.
       Background=Transparent is required so empty dial face receives mouse hits. -->
  <Viewbox Stretch="Uniform" StretchDirection="Both">
    <Grid Width="200" Height="252" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="200"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Horseshoe dial (needle / ticks / arcs). -->
      <Grid Grid.Row="0" Width="200" Height="200" ClipToBounds="False" Background="Transparent">
        <Canvas x:Name="TickCanvas" Width="200" Height="200" Background="Transparent"/>
        <!-- Clearer scale track (darker) + value arc -->
        <Path x:Name="TrackArc" Stroke="#8B949E" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85"/>
        <Path x:Name="ValueArc" Stroke="{StaticResource AccentBrush}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>

      <!-- Large numeric value + unit under the dial, not in the arc opening. -->
      <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Margin="0,4,0,2" Width="160">
        <TextBlock x:Name="ValueText" Text="—" FontFamily="{StaticResource MeasureMonoFont}" FontSize="26" FontWeight="Bold"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="UnitText" Text="kg" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
      </StackPanel>
    </Grid>
  </Viewbox>
</UserControl>
