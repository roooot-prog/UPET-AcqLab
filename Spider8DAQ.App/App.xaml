<Application x:Class="Spider8DAQ.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Spider8DAQ.App.Controls"
             xmlns:conv="clr-namespace:Spider8DAQ.App.Converters"
             >
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Themes/Generic.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- UPET AcqLab 3.3.96 — top tabs: compact lab buttons (fill + 1px border), not bare labels -->
    <Color x:Key="UpetRed">#C8102E</Color>
    <Color x:Key="UpetBlue">#0072C6</Color>
    <Color x:Key="BgColor">#DCE0E6</Color>
    <Color x:Key="PanelColor">#E8ECF0</Color>
    <Color x:Key="PanelAltColor">#DEE3E9</Color>
    <Color x:Key="BorderColor">#6E7780</Color>
    <Color x:Key="TextColor">#1A1A1A</Color>
    <Color x:Key="MutedColor">#555555</Color>
    <Color x:Key="RibbonColor">#DCE0E6</Color>
    <Color x:Key="HairlineColor">#9AA3AD</Color>
    <Color x:Key="GridLineColor">#9AA3AD</Color>
    <Color x:Key="StatusBarColor">#D4D8DE</Color>
    <Color x:Key="TabIdleColor">#444444</Color>
    <Color x:Key="TabFillColor">#E8ECF0</Color>
    <Color x:Key="TabSelectedFillColor">#D0D8E4</Color>
    <Color x:Key="TabSelectedBorderColor">#4A5560</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource UpetBlue}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource UpetRed}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="BorderBrushUi" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="RibbonBrush" Color="{StaticResource RibbonColor}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="{StaticResource StatusBarColor}"/>
    <SolidColorBrush x:Key="TabIdleBrush" Color="{StaticResource TabIdleColor}"/>
    <SolidColorBrush x:Key="TabFillBrush" Color="{StaticResource TabFillColor}"/>
    <SolidColorBrush x:Key="TabSelectedFillBrush" Color="{StaticResource TabSelectedFillColor}"/>
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="{StaticResource TabSelectedBorderColor}"/>
    <SolidColorBrush x:Key="MeasureValueBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="UnitBrush" Color="#555555"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#E8ECF0"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#C5D8EC"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#B4D0EC"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#10141A"/>
    <!-- DataGrid hover/selection: blue, never system beige/yellow -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B4D0EC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#B4D0EC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#10141A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#10141A"/>

    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    <!-- Measurement readouts: tabular / mono digits for vertical alignment. -->
    <FontFamily x:Key="MeasureMonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2"
                    Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0583D8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
    </Style>

    <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Workspace Live/Configure/Review: same height as ribbon tiles; soft selected (no solid fill) -->
    <Style x:Key="WorkspaceModeButton" TargetType="Button">
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WorkspaceModeOn" TargetType="Button" BasedOn="{StaticResource WorkspaceModeButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Header / ribbon: icon + full Romanian label, no cramped MaxWidth -->
    <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="RibbonLabelButton" TargetType="Button" BasedOn="{StaticResource HeaderActionButton}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    </Style>

    <!-- Info toggle (header): accent when InfoMode is on — style key required by MainWindow.xaml -->
    <Style x:Key="InfoToggleOn" TargetType="Button" BasedOn="{StaticResource HeaderActionButton}">
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding InfoMode}" Value="True">
          <Setter Property="Background" Value="#0072C6"/>
          <Setter Property="Foreground" Value="White"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Export / Replay top-level item: same compact tile as HeaderActionButton -->
    <Style x:Key="HeaderOverflowMenuItem" TargetType="MenuItem">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="MaxWidth" Value="48"/>
      <Setter Property="MaxHeight" Value="40"/>
      <Setter Property="Padding" Value="1,1"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2" Padding="{TemplateBinding Padding}"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    MinHeight="{TemplateBinding MinHeight}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    MaxHeight="{TemplateBinding MaxHeight}"
                    SnapsToDevicePixels="True">
              <Grid>
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       PopupAnimation="None">
                  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1"
                          Padding="4" Margin="0,1,0,0" MinWidth="200">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#C5D0DA"/>
              </Trigger>
              <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#C5D0DA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HealthBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="OperatorPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#E8ECF0"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="OperatorPillRec" TargetType="Border" BasedOn="{StaticResource OperatorPill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsRecording}" Value="True">
          <Setter Property="BorderBrush" Value="#C62828"/>
          <Setter Property="BorderThickness" Value="3"/>
          <Setter Property="Padding" Value="12,7"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SessionBadgeBorder" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="5,3"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushUi}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="5,3"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushUi}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Padding" Value="6,3"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Compact instrument tabs: light fill, 1px border, pressed selected (not labels + underline only). -->
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TabIdleBrush}"/>
      <Setter Property="Background" Value="{DynamicResource TabFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="tabBd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}"
                    Margin="0,0,3,1"
                    SnapsToDevicePixels="True"
                    Cursor="Hand">
              <DockPanel>
                <Border x:Name="underline" DockPanel.Dock="Bottom" Height="2"
                        Background="Transparent" Margin="0,2,0,0"/>
                <ContentPresenter ContentSource="Header"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  TextElement.FontWeight="{TemplateBinding FontWeight}"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource TabSelectedFillBrush}"/>
                <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource TabSelectedBorderBrush}"/>
                <Setter TargetName="underline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource TabSelectedBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushUi}"/>
      <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelAltBrush}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource HairlineBrush}"/>
      <Setter Property="RowHeight" Value="40"/>
      <Setter Property="ColumnHeaderHeight" Value="28"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="CanUserResizeColumns" Value="True"/>
      <Setter Property="MinRowHeight" Value="36"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushUi}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TreeView">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushUi}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushUi}"/>
    </Style>

    <!-- Instrument panel: hairline border, no shadow, tight radius -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushUi}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="AiryExpander" TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushUi}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
              <DockPanel>
                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Cursor="Hand"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Background="{StaticResource PanelAltBrush}" BorderThickness="0" Padding="10,7">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="hdr" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2,2,0,0">
                        <DockPanel>
                          <TextBlock x:Name="arrow" DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                     FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource MutedBrush}"/>
                          <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="arrow" Property="Text" Value="&#xE70D;"/>
                          <Setter TargetName="hdr" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="hdr" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </ToggleButton>
                <ContentPresenter x:Name="ExpandSite" Margin="10,4,10,10" Visibility="Collapsed"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MinimizedChipButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D6EBFF"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#0B4F8C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#BFDFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="OverflowMenu" TargetType="Menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="OverflowMenuItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Grup ribbon compact: fără chenar/umbră — doar separator hairline -->
    <Style x:Key="RibbonGroup" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
      <Setter Property="Padding" Value="10,2,8,2"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="RibbonGroupTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="RibbonToolbarSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
      <Setter Property="Margin" Value="5,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0.65"/>
    </Style>

    <!-- Shared ribbon chrome: panel + hairline; hover stays neutral (never Accent blue) -->
    <Style x:Key="RibbonChromeButton" TargetType="Button">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RibbonIconButton" TargetType="Button" BasedOn="{StaticResource RibbonChromeButton}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="RibbonIconToggle" TargetType="ToggleButton">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D6E8F5"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="#C5DCEF"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RibbonCompactPrimary" TargetType="Button" BasedOn="{StaticResource RibbonChromeButton}">
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>

    <!-- Must come after RibbonCompactPrimary (StaticResource order). -->
    <Style x:Key="PrimaryOpButton" TargetType="Button" BasedOn="{StaticResource RibbonCompactPrimary}">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="56"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushUi}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SecondaryOpButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="MeasureDigits" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MeasureMonoFont}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource MeasureValueBrush}"/>
    </Style>

    <Style x:Key="MeasureUnitText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource UnitBrush}"/>
    </Style>

    <Style x:Key="InstrumentPlate" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushUi}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="CanalExpertLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Width" Value="34"/>
    </Style>

    <Style x:Key="CanalExpertField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="MaxHeight" Value="20"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontFamily" Value="{StaticResource MeasureMonoFont}"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style x:Key="CanalExpertFieldCompact" TargetType="TextBox" BasedOn="{StaticResource CanalExpertField}">
      <Setter Property="FontSize" Value="9"/>
    </Style>

    <Style x:Key="MeasurePrimaryButton" TargetType="Button" BasedOn="{StaticResource RibbonButton}">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinWidth" Value="52"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>

    <Style x:Key="ConnectPrimaryButton" TargetType="Button" BasedOn="{StaticResource RibbonButton}">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinWidth" Value="56"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="#CDDCE8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>

    <Style x:Key="RecordPrimaryButton" TargetType="Button" BasedOn="{StaticResource MeasurePrimaryButton}">
      <Setter Property="Background" Value="#E8D0D4"/>
    </Style>

    <Style x:Key="RibbonTileButton" TargetType="Button" BasedOn="{StaticResource RibbonLabelButton}"/>

    <!-- Soft tint tiles — accent lives on the icon, not as a solid blue/green fill -->
    <Style x:Key="RibbonTileConnect" TargetType="Button" BasedOn="{StaticResource RibbonCompactPrimary}">
      <Setter Property="Background" Value="#DCEAF4"/>
    </Style>

    <Style x:Key="RibbonTileStart" TargetType="Button" BasedOn="{StaticResource RibbonCompactPrimary}">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    </Style>

    <Style x:Key="RibbonTileStop" TargetType="Button" BasedOn="{StaticResource RibbonCompactPrimary}">
      <Setter Property="Background" Value="#F0E2E5"/>
    </Style>

    <Style x:Key="RibbonTileRecord" TargetType="Button" BasedOn="{StaticResource RibbonCompactPrimary}">
      <Setter Property="Background" Value="#F0E2E5"/>
    </Style>

    <Style x:Key="RibbonTileUpet" TargetType="Button" BasedOn="{StaticResource RibbonCompactPrimary}">
      <Setter Property="Background" Value="#DCEAF4"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style x:Key="RibbonOverflowTile" TargetType="MenuItem" BasedOn="{StaticResource HeaderOverflowMenuItem}">
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>

    <Style x:Key="RibbonTileToggle" TargetType="ToggleButton" BasedOn="{StaticResource RibbonIconToggle}">
      <Setter Property="Width" Value="Auto"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="RibbonFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="RibbonFieldText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PlotTypeChip" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="chip" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushUi}"
                    BorderThickness="1" CornerRadius="2" Padding="8,4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chip" Property="Background" Value="#C5D6E4"/>
                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chip" Property="Background" Value="#C5D0DA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Full-width machine-state band (IEC: green running, red lost/rec, grey idle) -->
    <Style x:Key="StatusBand" TargetType="Border">
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Compact On-channel chip in the Citire strip (grouped, not full-width stretched). -->
    <Style x:Key="LiveStripChip" TargetType="Border">
      <Setter Property="MinWidth" Value="64"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HmiToggle" TargetType="ToggleButton" BasedOn="{StaticResource RibbonTileToggle}">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
