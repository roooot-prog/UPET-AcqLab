            <DataGrid ItemsSource="{Binding MacroSteps}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,0" Height="360">
              <DataGrid.Columns>
                <DataGridComboBoxColumn Header="Tip" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140"
                                        ItemsSource="{Binding DataContext.MacroStepTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>
