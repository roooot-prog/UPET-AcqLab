      <TabItem Header="Lab" x:Name="LabTabItem">
        <TabControl BorderThickness="0" Background="Transparent" Margin="0,4,0,0">
      <TabItem Header="Calibrare" x:Name="CalibrationTabItem">
        <Border Background="{StaticResource PanelBrush}" Margin="4" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Calibration wizard" FontSize="18" FontWeight="SemiBold"/>
              <WrapPanel Margin="0,8,0,0">
                <TextBox Text="{Binding CalChannel}" Width="40" ToolTip="CH# HW (0-based: CH0…CH7)"/>
                <TextBox Text="{Binding CalRaw}" Width="80" ToolTip="Raw"/>
                <TextBox Text="{Binding CalRef}" Width="80" ToolTip="Reference"/>
                <Button Content="Add point" Command="{Binding AddCalibrationPointCommand}"/>
                <Button Content="Fit" Command="{Binding FitCalibrationCommand}"/>
                <Button Content="Apply to CH" Command="{Binding ApplyCalibrationCommand}"/>
              </WrapPanel>
              <DataGrid ItemsSource="{Binding CalibrationPoints}" AutoGenerateColumns="True" Height="160" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Wiring diagram" FontSize="18" FontWeight="SemiBold"/>
              <Button Content="Show for selected CH#" Command="{Binding ShowWiringCommand}" Margin="0,8,0,8" HorizontalAlignment="Left"/>
              <TextBox Text="{Binding WiringText, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="160" FontFamily="Consolas" IsReadOnly="True"/>
            </StackPanel>

            <!-- Metrologie exactitate (puncte 5–13) -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource PanelAltBrush}" Padding="12" Margin="0,16,0,0"
                    BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1" CornerRadius="4">
              <StackPanel>
                <TextBlock Text="Metrologie — exactitate măsurătoare" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"
                           Text="Filtru LPF software (Bessel/Butterworth) pe live+Record; Citire treaptă = mediană/medie pe fereastră; Δ% vs m·g; liniaritate ε(F); histereză Zero; diagnostice Exc/Scale."/>
                <TextBlock Text="{Binding SyncNoteText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>

                <TextBlock Text="5. Filtru anti-alias" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <WrapPanel>
                  <TextBlock Text="Tip LPF" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding MetrologyFilterKinds}" SelectedItem="{Binding MetrologyFilterKind}" Width="120" Margin="8,0,12,0"/>
                  <Button Content="Filtru = Rate/10" Command="{Binding ApplyDefaultSoftwareFiltersCommand}"
                          ToolTip="Setează FilterHz ≈ SampleRate/10 pe canale ON și reactivează LPF software."/>
                  <TextBlock Text="Fereastră s" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <TextBox Text="{Binding StepWindowSeconds}" Width="48" Margin="6,0,0,0"/>
                  <TextBlock Text="Agregat" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <ComboBox ItemsSource="{Binding StepAggregateKinds}" SelectedItem="{Binding StepAggregateKindName}" Width="100" Margin="6,0,0,0"/>
                </WrapPanel>

                <TextBlock Text="7–8. Citire treaptă + erori vs referință" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <WrapPanel>
                  <TextBlock Text="Masă kg" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding StepMassKg, UpdateSourceTrigger=PropertyChanged}" Width="56" Margin="6,0,8,0"
                           ToolTip="Referință F = m·g (g=9.80665)"/>
                  <TextBlock Text="sau F ref N" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding StepReferenceForceN, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="6,0,8,0"/>
                  <TextBlock Text="Etichetă" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding StepLabel, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="6,0,8,0"/>
                  <TextBlock Text="CH F" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding MetrologyForceChannel}" Width="36" Margin="4,0,8,0" ToolTip="Index HW forță (0-based)"/>
                  <TextBlock Text="CH ε" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding MetrologyStrainChannel}" Width="36" Margin="4,0,8,0" ToolTip="Index HW strain"/>
                  <Button Content="Citire treaptă" Command="{Binding CaptureStepReadingCommand}"
                          local:HelpTip.Text="Mediană/medie pe ultimele ~0.75 s (valori filtrate) — citire oficială pe treaptă."/>
                  <Button Style="{StaticResource GhostButton}" Content="Șterge trepte" Command="{Binding ClearMetrologyStepsCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding StepRefPreview}" Margin="0,4,0,4" FontFamily="Consolas" FontSize="11"/>

                <DataGrid ItemsSource="{Binding MetrologySteps}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" MaxHeight="180" Margin="0,4,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Step}" Width="36"/>
                    <DataGridTextColumn Header="Etichetă" Binding="{Binding Label}" Width="90"/>
                    <DataGridTextColumn Header="m kg" Binding="{Binding MassKg}" Width="50"/>
                    <DataGridTextColumn Header="Ref N" Binding="{Binding RefN}" Width="70"/>
                    <DataGridTextColumn Header="F măsurat" Binding="{Binding Force}" Width="80"/>
                    <DataGridTextColumn Header="ε" Binding="{Binding Strain}" Width="80"/>
                    <DataGridTextColumn Header="Δ%" Binding="{Binding DeltaPct}" Width="60"/>
                    <DataGridTextColumn Header="Notă" Binding="{Binding Note}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="9. Liniaritate ε(F)" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <WrapPanel>
                  <Button Content="Calculează ε(F)" Command="{Binding ComputeLinearityCommand}"
                          ToolTip="Slope, intercept, R² din trepte; prag R²≥0.999"/>
                  <Button Content="Export Excel metrologie" Command="{Binding ExportMetrologyExcelCommand}" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBlock Text="{Binding LinearityText}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold"/>

                <TextBlock Text="10. Histereză Zero" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <WrapPanel>
                  <Button Content="Marchează Zero (înainte)" Command="{Binding MarkHysteresisZeroCommand}"
                          ToolTip="Zero pe liber înainte de încărcare"/>
                  <Button Content="Măsoară residual (după descărcare)" Command="{Binding MeasureHysteresisResidualCommand}" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBlock Text="{Binding HysteresisText}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="11–13. Diagnostice" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <WrapPanel>
                  <CheckBox Content="Sarcină mare OK (suprimă Scale suspect)" IsChecked="{Binding HighLoadAcknowledged}" VerticalAlignment="Center"/>
                  <Button Content="Confirmă sarcină mare" Command="{Binding AcknowledgeHighLoadCommand}" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBlock Text="{Binding MetrologyDiagText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding MetrologyStatus}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" FontSize="11"/>
              </StackPanel>
            </Border>
          </Grid>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="Defecte" x:Name="DefectsTabItem">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1.1*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource PanelBrush}" Padding="12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
