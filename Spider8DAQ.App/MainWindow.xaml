            <Border Background="{StaticResource PanelBrush}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Project snapshots / diff" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Save snapshot" Command="{Binding SaveSnapshotCommand}"/>
                  <ComboBox ItemsSource="{Binding SnapshotFiles}" SelectedItem="{Binding SelectedSnapshotA}" Width="260"/>
                  <ComboBox ItemsSource="{Binding SnapshotFiles}" SelectedItem="{Binding SelectedSnapshotB}" Width="260"/>
                  <Button Content="Diff" Command="{Binding DiffSnapshotsCommand}"/>
                </WrapPanel>
                <TextBox Text="{Binding DiffText}" Height="160" AcceptsReturn="True" FontFamily="Consolas" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Inspector BIN + rapoarte" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Inspect .bin" Command="{Binding InspectBinCommand}"/>
                  <Button Content="Export PDF" Command="{Binding ExportPdfCommand}"/>
                  <Button Content="Raport industrial" Command="{Binding ExportIndustrialReportCommand}"/>
                  <Button Content="Device info" Command="{Binding DeviceInfoCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding DeviceInfoText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ListBox ItemsSource="{Binding BinPreviewLines}" Height="160" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" Padding="12">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Macro flowchart" FontWeight="SemiBold"/>
                  <Button DockPanel.Dock="Right" Content="Refresh flow" Command="{Binding RefreshMacroFlowCommand}" Margin="0"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding MacroFlowLines}" Height="180" Margin="0,8,0,0" FontFamily="Consolas"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="▸ Sănătate" x:Name="HealthTabItem"
               Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource PanelBrush}" Padding="12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Stare dispozitiv" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HealthText}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="Self-test" Command="{Binding SelfTestCommand}"/>
                  <Button Content="Toggle watchdog" Command="{Binding ToggleWatchdogCommand}"/>
                  <CheckBox Content="Watchdog activ" IsChecked="{Binding WatchdogEnabled}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Watchdog: la streaming, dacă nu vin eșantioane ~4s încearcă reconectare (USBHBM verifică PnP)."/>
              </StackPanel>
              <ListBox ItemsSource="{Binding HealthChecks}" Margin="0,12,0,0"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Measurement database" FontSize="18" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,8,0,8">
                  <TextBox Text="{Binding DbSearch, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="Search"/>
                  <TextBox Text="{Binding MeasurementTags}" Width="120" ToolTip="Tags for next recording"/>
                  <Button Content="Search" Command="{Binding SearchDbCommand}"/>
                  <Button Content="Open selected" Command="{Binding OpenDbFileCommand}"/>
                </WrapPanel>
              </StackPanel>
              <DataGrid ItemsSource="{Binding DbResults}" SelectedItem="{Binding SelectedDbRow}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="When" Binding="{Binding Created}" Width="120"/>
                  <DataGridTextColumn Header="Sample" Binding="{Binding SampleId}" Width="80"/>
                  <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="90"/>
                  <DataGridTextColumn Header="N" Binding="{Binding Samples}" Width="50"/>
                  <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="80"/>
                  <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="▸ Sync" x:Name="SyncTabItem"
               Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
        <Border Background="{StaticResource PanelBrush}" Margin="4" Padding="14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Sync multi-rate / frame-gap" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding SyncLines}"/>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Jurnal" x:Name="JournalTabItem">
        <Border Background="{StaticResource PanelBrush}" Margin="4" Padding="14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Setup / erori / evenimente (și în logs/)" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding JournalLines}"/>
          </DockPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
