                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9E9;" FontSize="14"/>
                      </Button>
                      <ToggleButton IsChecked="{Binding ShowLiveGauge}" Style="{StaticResource RibbonIconToggle}"
                                    ToolTip="Afișează cadranele gradate">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="14"/>
                      </ToggleButton>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding AddLiveGaugeCommand}"
                              ToolTip="Adaugă un cadran mobil">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="14"/>
                      </Button>
                      <ToggleButton IsChecked="{Binding FollowLiveZoom}" Style="{StaticResource RibbonIconToggle}"
                                    ToolTip="Urmărește live (scară Y auto)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="14"/>
                      </ToggleButton>
                      <ToggleButton IsChecked="{Binding PanelMode}" Style="{StaticResource RibbonIconToggle}"
                                    ToolTip="Mod panel — spațiu maxim pentru grafic">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE740;" FontSize="14"/>
                      </ToggleButton>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding AutoscalePlotsCommand}"
                              ToolTip="Autoscale Y pe Grafic live + panouri canal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9A6;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ResetPlotZoomCommand}"
                              ToolTip="Reset zoom">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding JobApplyVizCommand}"
                              ToolTip="Aplică vizualizarea din presetul Experiment">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B5;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ApplyHydraulicPressCommand}"
                              ToolTip="Preset Presă hidraulică UPET">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA80;" FontSize="14"/>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- PROIECT / EXPORT -->
                <Border Style="{StaticResource RibbonGroup}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource RibbonGroupTitle}" Text="EXPORT"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding SaveProjectCommand}"
                              ToolTip="Salvează proiectul">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding LoadProjectCommand}"
                              ToolTip="Încarcă proiect">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding DownloadCsvCommand}"
                              ToolTip="Descarcă CSV…">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding OpenCsvFolderCommand}"
                              ToolTip="Deschide folder înregistrări">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B8;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ExportExcelCommand}"
                              ToolTip="Export Excel + grafice pe canale">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ExportPdfCommand}"
                              ToolTip="Raport PDF (cu preview)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA90;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonCompactPrimary}" Command="{Binding ExportIndustrialReportCommand}"
                              ToolTip="Raport industrial (PDF) — 1–2 pagini, laborator metrologic"
                              local:HelpTip.Text="PDF compact: identitate, probă, metodă, zonă CursorA–B, rezultate, semnaturi, disclaimer.">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="13"
                                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                          <TextBlock Text="Ind." VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ExportHtmlReportCommand}"
                              ToolTip="Raport HTML">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE12B;" FontSize="14"/>
                      </Button>
                      <Border Style="{StaticResource RibbonToolbarSeparator}"/>
                      <Button Style="{StaticResource RibbonTileUpet}" Command="{Binding ExportUpetReportCommand}"
                              ToolTip="Export raport proprietar UPET (.upet) — doar această aplicație îl citește"
                              local:HelpTip.Text="Salvează raport binar .upet (criptat). Se deschide doar în UPET AcqLab.">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72D;" FontSize="13"
                                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                          <TextBlock Text=".upet" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource RibbonCompactPrimary}" Command="{Binding OpenUpetReportCommand}"
                              ToolTip="Deschide raport UPET (.upet)"
                              local:HelpTip.Text="Încarcă un raport .upet salvat anterior.">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" FontSize="13"
                                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                          <TextBlock Text="Open" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Border Style="{StaticResource RibbonToolbarSeparator}"/>
                      <Button Style="{StaticResource RibbonCompactPrimary}" Command="{Binding ExportLabPackageCommand}"
                              ToolTip="Pachet laborator (ZIP sau .upetlab cu parolă AES)"
                              local:HelpTip.Text="Un singur pachet: README + CSV + poze + .upet + Excel/HTML. Opțional parolă AES (.upetlab).">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13"
                                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                          <TextBlock Text="Pachet" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding OpenLabPackageCommand}"
                              ToolTip="Deschide pachet laborator (.zip / .upetlab)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ExportTxtCommand}"
                              ToolTip="Export TXT">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ExportMatCommand}"
                              ToolTip="Export MATLAB (.mat)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ExportDiademCommand}"
                              ToolTip="Export DIAdem / DAT">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F5;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ReplayCommand}"
                              ToolTip="Replay CSV…">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ImportMatestCommand}"
                              ToolTip="Import Matest TXT…">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B5;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding OpenJournalFolderCommand}"
                              ToolTip="Deschide jurnal / CSV">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D5;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Click="ResetLayout_Click"
                              ToolTip="Resetează layout carduri Măsurare (dacă Canale DAQ e scurt și are bară verticală)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" FontSize="14"/>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- AJUTOR -->
                <Border Style="{StaticResource RibbonGroup}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource RibbonGroupTitle}" Text="AJUTOR"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ToggleInfoModeCommand}"
                              ToolTip="Ajutor contextual pe butoane (hover)"
                              local:HelpTip.Text="Ajutor contextual pe butoane (hover).">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ToggleAboutPanelCommand}"
                              ToolTip="Despre UPET AcqLab">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE897;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ToggleShortcutsPanelCommand}"
                              ToolTip="Scurtături tastatură (F1)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE765;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding FirstMeasureWizardCommand}"
                              ToolTip="Asistent prima măsurătoare">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ShowDb15WiringGuideCommand}"
                              ToolTip="Ghid cablare DB15">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE95F;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding UndoChannelEditCommand}"
                              ToolTip="Undo canal (Ctrl+Z)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" FontSize="14"/>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                </WrapPanel>
              </Expander>

              <Grid Margin="0,4,0,0"
                    Visibility="{Binding IsConnectProgressVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Height="6" Minimum="0" Maximum="100"
                             Value="{Binding ConnectProgress}"
                             Foreground="#0072C6" Background="#D6DEE8"/>
                <TextBlock Grid.Row="1" Text="{Binding ConnectStageText}" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>

            <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrushUi}" BorderThickness="1" CornerRadius="6"
                    Padding="16,12" Margin="0,0,0,14"
                    Visibility="{Binding ShowShortcutsPanel, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Închide" Command="{Binding ToggleShortcutsPanelCommand}"
                        Style="{StaticResource GhostButton}" Padding="10,6" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding ShortcutsHelpText}" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" LineHeight="20"/>
              </DockPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushUi}" BorderThickness="1" CornerRadius="6"
                    Padding="0" Margin="0,0,0,14"
                    Visibility="{Binding ShowAboutPanel, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Height="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#002B7F" CornerRadius="6,0,0,0"/>
                  <Border Grid.Column="1" Background="#FCD116"/>
                  <Border Grid.Column="2" Background="#CE1126" CornerRadius="0,6,0,0"/>
                </Grid>
                <Button DockPanel.Dock="Right" Content="Închide" Command="{Binding ToggleAboutPanelCommand}"
                        Style="{StaticResource GhostButton}" Padding="10,6" VerticalAlignment="Top" Margin="0,12,16,0"/>
                <StackPanel Margin="16,12,16,12">
                  <TextBlock Text="{Binding AppInfoText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <TextBlock Margin="0,0,0,6">
                    <Run Text="Versiune: " Foreground="{StaticResource MutedBrush}"/>
                    <Run Text="{Binding AppVersion, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold"/>
                  </TextBlock>
                  <TextBlock Text="{Binding DriverHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                             FontSize="11" Margin="0,0,0,10"/>
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Deschide folder" Command="{Binding OpenRecordingsFromAboutCommand}"
                            Style="{StaticResource GhostButton}" Padding="8,4" Margin="8,0,0,0"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                      <Run Text="Înregistrări: " Foreground="{StaticResource MutedBrush}"/>
                      <Run Text="{Binding RecordingsFolderPath, Mode=OneWay}" FontFamily="Consolas"/>
                    </TextBlock>
                  </DockPanel>
                  <TextBlock Text="© Universitatea din Petroșani · Facultatea de Inginerie Mecanică și Electrică · UPET AcqLab · Autor soft: drd. ing. Iucal Ilie"
                             FontSize="10" Foreground="{StaticResource MutedBrush}" FontStyle="Italic"/>
                </StackPanel>
              </DockPanel>
            </Border>

          </StackPanel>
      </StackPanel>
    </Border>

    <!-- Lab advisor / AI suggestions -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrushUi}" BorderThickness="0,1,0,0"
            Padding="12,8" MaxHeight="280"
            Visibility="{Binding ShowAdvisorPanel, Converter={StaticResource BoolToVis}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
          <Button Content="Utilă" Command="{Binding AdvisorFeedbackHelpfulCommand}" Style="{StaticResource GhostButton}"
                  Padding="8,4" Margin="0,0,4,0" ToolTip="Marchează sugestia ca utilă (învățare)"/>
          <Button Content="Nu" Command="{Binding AdvisorFeedbackNotHelpfulCommand}" Style="{StaticResource GhostButton}"
                  Padding="8,4" Margin="0,0,4,0" ToolTip="Sugestia nu a ajutat"/>
          <Button Content="Șterge" Command="{Binding ClearAdvisorSuggestionsCommand}" Style="{StaticResource GhostButton}"
                  Padding="8,4" Margin="0,0,4,0"/>
          <Button Content="Ascunde" Command="{Binding ToggleAdvisorPanelCommand}" Style="{StaticResource GhostButton}"
                  Padding="8,4"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Asistent lab (sugestii + învățare)" FontWeight="SemiBold" Foreground="#33691E" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding AdvisorModuleHint}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap" Margin="0,0,0,6"/>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Întreabă" Command="{Binding AdvisorAskCommand}" Padding="10,4" Margin="8,0,0,0"
                    ToolTip="Enter în casetă = aceeași acțiune"/>
            <TextBox Text="{Binding AdvisorAskText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Ex: de ce nu primesc date de pe P15? / OpenPort eșuat / LED ERROR — Enter = Întreabă">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding AdvisorAskCommand}"/>
                <KeyBinding Key="Enter" Command="{Binding AdvisorAskCommand}"/>
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
          <TextBlock Text="{Binding AdvisorBannerTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Visibility="{Binding HasAdvisorSuggestions, Converter={StaticResource BoolToVis}}"/>
          <ItemsControl ItemsSource="{Binding AdvisorSuggestions}" Margin="0,4,0,0"
                        Visibility="{Binding HasAdvisorSuggestions, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right"
                              Content="{Binding ActionLabel}"
                              Command="{Binding DataContext.AdvisorQuickActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding ActionId}"
                              Padding="8,2" Margin="8,0,0,0" FontSize="11"
                              Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                              ToolTip="Rulează acțiunea sugerată"/>
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run Text="["/><Run Text="{Binding SeverityLabel}"/><Run Text="] "/><Run Text="{Binding Title}"/>
                      </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBlock Text="{Binding StepsText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Istoric întrebări" FontWeight="SemiBold" FontSize="11" Foreground="#33691E" Margin="0,6,0,2"
                     Visibility="{Binding HasAdvisorQaHistory, Converter={StaticResource BoolToVis}}"/>
          <ItemsControl ItemsSource="{Binding AdvisorQaHistory}" Margin="0,0,0,4"
                        MaxHeight="72"
                        Visibility="{Binding HasAdvisorQaHistory, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding AdvisorLearningSummary}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                     Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
      </ScrollViewer>
    </Border>

    <!-- Status bar: one instrument line (details in tooltip) + PC local clock -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBarBrush}" Padding="8,3"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
            ToolTip="{Binding StatusDetailTooltip}">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE946;"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12"/>
        <Button DockPanel.Dock="Right" Content="Asistent" Command="{Binding ShowAdvisorPanelCommand}"
                Style="{StaticResource GhostButton}" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                FontSize="11"
                ToolTip="Redeschide panoul Asistent lab (sugestii + AI)"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding AdvisorStatusHint}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"
                   Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10"
                   TextTrimming="CharacterEllipsis" MaxWidth="160"
                   Visibility="{Binding ShowAdvisorStatusHint, Converter={StaticResource BoolToVis}}"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding PcClockText}"
                   FontFamily="{StaticResource MeasureMonoFont}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                   ToolTip="{Binding PcClockTooltip}"/>
        <TextBlock Text="{Binding StatusLineCompact}" FontFamily="{StaticResource MeasureMonoFont}" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding StatusDetailTooltip}"/>
      </DockPanel>
    </Border>

    <!-- Jurnal: 1 row default (last EST/status); Extinde for the rest -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="8,4">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,2">
          <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsJournalExpanded}"
                        Style="{StaticResource HmiToggle}" Margin="8,0,0,0" Padding="6,2" MinHeight="22"
                        ToolTip="Extinde / restrânge jurnalul">
            <TextBlock Text="{Binding JournalExpandLabel}"/>
          </ToggleButton>
          <TextBlock Text="JURNAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
          <TextBlock Text="{Binding LastJournalLine}" FontFamily="Consolas" FontSize="11"
                     Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsJournalExpanded, Converter={StaticResource InverseBoolToVis}}"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding JournalLines}" Height="{Binding JournalPaneHeight}"
                 FontFamily="Consolas" FontSize="11" BorderThickness="0"
                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Visibility="{Binding IsJournalExpanded, Converter={StaticResource BoolToVis}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Alerte fixe (sub ribbon, deasupra tab-urilor) — mereu vizibile -->
    <StackPanel DockPanel.Dock="Top" Margin="8,6,8,0">
      <Border Background="{Binding FaultBannerBrush}" BorderThickness="0" Padding="12,8" Margin="0,0,0,6"
              Visibility="{Binding ShowFaultBanner, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"
                     Foreground="White" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding FaultBannerText}" Foreground="White" FontWeight="Bold" FontSize="13"
                     FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Border Background="#FFF0F2" BorderBrush="#C62828" BorderThickness="2" CornerRadius="4"
              Padding="10,8" Margin="0,0,0,6"
              Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7C8;"
                     Foreground="{StaticResource AccentRedBrush}" FontSize="16" Margin="0,0,8,0"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding RecordingInfoText}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                     TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#B71C1C"/>
        </DockPanel>
      </Border>
      <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4"
              Padding="10,6" Margin="0,0,0,6"
              Visibility="{Binding DisplayFrozen, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="HOLD — afișaj înghețat; achiziția/Record continuă."
                   FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
      </Border>
      <Border Background="#FFF3E0" BorderBrush="#E65100" BorderThickness="2" CornerRadius="4"
              Padding="10,8" Margin="0,0,0,6"
              Visibility="{Binding ShowPolarityWarningBanner, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button Content="OK — continuați" Command="{Binding DismissPolarityWarningCommand}"
                    Padding="12,5" Margin="0,0,6,0" FontWeight="SemiBold"
                    Background="#D4E5DA"
                    ToolTip="Continuați măsurarea; avertismentul se ascunde (achiziția nu se oprește)"/>
            <Button Content="Inversare CH" Command="{Binding InvertWarnedChannelPolarityCommand}"
                    Padding="10,4" FontWeight="SemiBold" Background="#FFE0B2"
                    Visibility="{Binding ShowDefectInvertButton, Converter={StaticResource BoolToVis}}"
                    ToolTip="Inversează polaritatea canalului din avertisment (Scale × −1), apoi faceți Zero pe liber"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"
                     Foreground="#E65100" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding PolarityWarningText}" TextWrapping="Wrap"
                       FontWeight="SemiBold" FontSize="12" Foreground="#BF360C"/>
            <TextBlock Text="Măsurarea NU e blocată — OK și continuați Start / Rec."
                       FontSize="11" Margin="0,4,0,0" Foreground="#5A65A8"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>

    <TabControl Margin="10,12,10,6" BorderThickness="0" Background="Transparent"
                SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="Măsurare" x:Name="MeasureTabItem">
        <DockPanel Margin="2,4,2,2">
          <!-- Bară panouri minimalizate (taskbar) -->
          <Border x:Name="MinimizedCardsDock" DockPanel.Dock="Bottom"
                  Background="#3A4550" BorderBrush="#2A333C" BorderThickness="0,1,0,0"
                  Padding="8,5" Margin="0,4,0,0"
                  Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="MINIMIZATE" FontSize="10" FontWeight="Bold"
                         Foreground="#F0F4F8" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ItemsControl x:Name="MinimizedCardsBar">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DockPanel>
          </Border>
          <ScrollViewer x:Name="MeasureWorkspaceScroll" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto" Padding="0">
          <Canvas x:Name="MeasureWorkspaceCanvas" ClipToBounds="False" Background="{StaticResource BgBrush}"
                  MinWidth="1280" MinHeight="720"
                  SizeChanged="WorkspaceCanvas_SizeChanged">
            <!-- Zone: Canale | Plot | Cadran (fără separatoare decorative — dungi eliminate) -->

            <ctrl:MovableResizableCard x:Name="CardChannels" CardId="measure.channels" Title="Canale DAQ"
                                       Canvas.Left="4" Canvas.Top="4" Width="720" Height="520"
                                       MinWidth="560" MinHeight="400" Panel.ZIndex="10">
              <Grid ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="228"/>
                </Grid.ColumnDefinitions>
                <!-- Operator grid: every column is star (Citire 1.4*, Senzor 2*) so they all grow with the card. -->
                <Grid Grid.Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <DataGrid x:Name="ChannelsGrid" Grid.Row="0"
                            BeginningEdit="ChannelsGrid_BeginningEdit" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannelRow}"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False"
                            HeadersVisibility="Column" GridLinesVisibility="All"
                            HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                            VerticalGridLinesBrush="{DynamicResource GridLineBrush}"
                            RowHeaderWidth="0" BorderThickness="0"
                            RowHeight="36" ColumnHeaderHeight="36" FontSize="12"
                            MinRowHeight="34"
                            Loaded="ChannelsGrid_Loaded" SizeChanged="ChannelsGrid_SizeChanged"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.CanContentScroll="True"
                            EnableColumnVirtualization="False"
                            EnableRowVirtualization="False"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            ContextMenu="{StaticResource ChannelContextMenu}"
                            PreviewMouseRightButtonDown="ChannelGrid_PreviewMouseRightButtonDown"
                            local:HelpTip.Text="Click dreapta pe canal: Zero, Shunt, Aplică senzor. On = achiziție. Expert: Graf/Rec/Scale în CANAL SELECTAT."
                            xmlns:local="clr-namespace:Spider8DAQ.App">
                    <DataGrid.Resources>
                      <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                      </Style>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Style.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                      <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter Property="Opacity" Value="0.76"/>
                            <Setter Property="MinHeight" Value="28"/>
                          </DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                      <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              Width="*" MinWidth="40">
                        <DataGridCheckBoxColumn.ElementStyle>
                          <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                          </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                      </DataGridCheckBoxColumn>
                      <DataGridTemplateColumn Header="LED" Width="*" MinWidth="32">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Ellipse Width="10" Height="10" Fill="{Binding ChannelLedBrush}"
                                     Stroke="#5A6573" StrokeThickness="0.6" HorizontalAlignment="Center"
                                     ToolTip="{Binding ChannelLedTooltip}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Nume" Width="*" MinWidth="72">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Width="4" Margin="0,1,4,1" CornerRadius="1"
                                      Background="{Binding ChannelAccentBrush}"
                                      ToolTip="{Binding ChannelAccentHex}"/>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                         Foreground="{Binding ChannelAccentBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                          <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="2,1"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Citire" Width="1.4*" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="2,0">
                              <TextBlock Text="{Binding LiveReading}" Style="{StaticResource MeasureDigits}"
                                         FontSize="15" FontWeight="Bold" VerticalAlignment="Bottom" TextTrimming="None"/>
                              <TextBlock Text="{Binding CitireUnitDisplay}" Style="{StaticResource MeasureUnitText}"
                                         FontSize="11" Margin="4,0,0,1" VerticalAlignment="Bottom"/>
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Unit" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                          Width="*" MinWidth="56"/>
                      <DataGridTemplateColumn Header="Semnal" Width="*" MinWidth="72">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" Margin="2,0">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="#E8EEF4"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding SignalStatus}" Value="OK">
                                      <Setter Property="Background" Value="#C8E6C9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SignalStatus}" Value="aștept">
                                      <Setter Property="Background" Value="#E3F2FD"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SignalStatus}" Value="lipsă">
                                      <Setter Property="Background" Value="#FFECB3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SignalStatus}" Value="off">
                                      <Setter Property="Background" Value="#ECEFF1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SignalStatus}" Value="Overflow">
                                      <Setter Property="Background" Value="#FFCDD2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SignalStatus}" Value="lost">
                                      <Setter Property="Background" Value="#FFCDD2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SignalStatus}" Value="pierdut">
                                      <Setter Property="Background" Value="#FFCDD2"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding SignalStatus}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Punte" Binding="{Binding Bridge, UpdateSourceTrigger=PropertyChanged}"
                                          Width="*" MinWidth="64"/>
                      <DataGridTextColumn Header="Senzor" Binding="{Binding SensorFunctionDisplay}" IsReadOnly="True"
                                          Width="2*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding SensorFunctionDisplay}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <DockPanel Grid.Row="1" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="CH" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                      <TextBox Text="{Binding SelectedChannelForSensor}" Width="44" Margin="0,0,10,0"
                               ToolTip="Apply CH# = index HW / nume grilă (CH0=0 … CH7=7). Preferă click pe rândul din grilă."/>
                      <Button Content="Zero CH" Command="{Binding TareSelectedCommand}" Margin="0,0,8,0"
                              local:HelpTip.Text="Zero balance pe canalul selectat." xmlns:local="clr-namespace:Spider8DAQ.App"/>
                      <TextBlock Text="Dif. %" VerticalAlignment="Center" Margin="8,0,6,0"
                                 ToolTip="catman Easy A05566 §4.20: procent din dezechilibrul așteptat (0.5–5%, tipic 0.5%). Shunt CH PASS dacă |măsurat−așteptat|/așteptat ≤ acest %."/>
                      <ComboBox ItemsSource="{Binding ShuntAllowedDifferenceOptions}"
                                SelectedItem="{Binding ShuntAllowedDifferencePercent, UpdateSourceTrigger=PropertyChanged}"
                                Width="64" VerticalAlignment="Center"
                                ItemStringFormat="{}{0:0.##}"/>
                    </StackPanel>
                    <Menu DockPanel.Dock="Right" Style="{StaticResource OverflowMenu}" VerticalAlignment="Center">
                      <MenuItem Header="Mai mult ▾" Style="{StaticResource OverflowMenuItem}">
                        <MenuItem Header="Shunt CH" Command="{Binding ShuntSelectedCommand}"/>
                        <MenuItem Header="Shunt all" Command="{Binding ShuntAllCommand}"/>
                        <MenuItem Header="Aplică Scale din shunt" Command="{Binding ApplyScaleFromShuntCommand}"
                                  ToolTip="Doar după Shunt CH PASS (sau ±20%) pe canal µm/m, cu confirmare."/>
                        <MenuItem Header="Preflight" Command="{Binding PreflightCommand}"/>
                        <MenuItem Header="Verificare senzor" Command="{Binding VerifySensorCommand}"/>
                        <Separator/>
                        <MenuItem Header="Deschide grafic separat CH" Command="{Binding OpenSeparatePlotForSelectedCommand}"/>
                        <MenuItem Header="Adaugă panou grafic" Command="{Binding AddChannelPlotCommand}"/>
                        <Separator/>
                        <MenuItem Header="Rec all (ON)" Command="{Binding RecAllEnabledCommand}"/>
                        <MenuItem Header="Rec none" Command="{Binding RecNoneCommand}"/>
                        <MenuItem Header="Filtru BE = Rate/10" Command="{Binding ApplyDefaultFiltersCommand}"
                                  ToolTip="Setează FilterHz ≈ SampleRate/10 pe canalele ON (stil Easy)."/>
                        <Separator/>
                        <MenuItem Header="Toate pe graf" Command="{Binding ShowAllChannelsOnPlotCommand}"/>
                        <MenuItem Header="Ascunde graf" Command="{Binding HideAllChannelsOnPlotCommand}"/>
                      </MenuItem>
                    </Menu>
                  </DockPanel>
                  <TextBox x:Name="ShuntStatusBox" Grid.Row="2"
                           Text="{Binding LastShuntStatus, Mode=OneWay}"
                           IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="0" MaxHeight="72"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           FontFamily="Consolas" FontSize="11"
                           Margin="0,6,0,0" Padding="6,4"
                           VerticalContentAlignment="Top"
                           BorderThickness="1"
                           ToolTip="Rezultat Shunt CH — FAIL, Timbru, Sugestie (fără derulare orizontală).">
                    <TextBox.Style>
                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LastShuntStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                  <ListBox Grid.Row="3" ItemsSource="{Binding PreflightLines}" MaxHeight="64" MinHeight="0" Margin="0,6,0,0" FontFamily="Consolas" FontSize="11"
                           BorderThickness="0" Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <ListBox Grid.Row="4" ItemsSource="{Binding SensorVerifyLines}" MaxHeight="64" MinHeight="0" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11"
                           BorderThickness="0" Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                <Border Grid.Column="1" Background="Transparent" ClipToBounds="True"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0" Padding="4,2"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <TextBlock Text="CANAL SELECTAT" FontSize="9" FontWeight="Bold"
                                 Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                      <TextBlock Text="Selectați un rând din grilă." FontSize="11" TextWrapping="Wrap"
                                 Foreground="{DynamicResource MutedBrush}"
                                 Visibility="{Binding HasSelectedChannel, Converter={StaticResource InverseBoolToVis}}"/>
                      <StackPanel Visibility="{Binding HasSelectedChannel, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource InstrumentPlate}">
                          <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                              <Ellipse DockPanel.Dock="Right" Width="14" Height="14" Margin="6,0,0,0"
                                       Fill="{Binding SelectedChannelRow.ChannelLedBrush}" VerticalAlignment="Center"
                                       ToolTip="{Binding SelectedChannelRow.ChannelLedTooltip}"/>
                              <TextBlock Text="{Binding SelectedChannelRow.Name}" FontWeight="Bold" FontSize="15"
                                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                              <TextBlock Text="{Binding SelectedChannelRow.LiveReading}"
                                         Style="{StaticResource MeasureDigits}" FontSize="26"
                                         TextAlignment="Right"/>
                              <TextBlock Text="{Binding SelectedChannelRow.CitireUnitDisplay}" Style="{StaticResource MeasureUnitText}"
                                         FontSize="12" Margin="6,0,0,2" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedChannelRow.BridgeGfDisplay}" FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding SelectedChannelRow.SignalHeadline}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding SelectedChannelRow.SignalHeadlineBrush}"/>
                          </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="Detalii expert" FontSize="9" FontWeight="Bold"
                                     Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                          <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Graf" IsChecked="{Binding SelectedChannelRow.ShowOnPlot, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" FontSize="11"
                                      ToolTip="Afișare pe graficul Y(t)"/>
                            <CheckBox Grid.Column="1" Content="Rec" IsChecked="{Binding SelectedChannelRow.RecordEnabled, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" FontSize="11"
                                      ToolTip="Include canalul în Record CSV"/>
                            <CheckBox Grid.Column="2" Content="Alm" IsChecked="{Binding SelectedChannelRow.AlarmEnabled, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" FontSize="11"/>
                          </Grid>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="6"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,2">
                              <TextBlock DockPanel.Dock="Left" Text="Scale" Style="{StaticResource CanalExpertLabel}"/>
                              <TextBox Style="{StaticResource CanalExpertField}"
                                       Text="{Binding SelectedChannelRow.Scale, UpdateSourceTrigger=LostFocus, StringFormat=0.0}"
                                       GotKeyboardFocus="ExpertScale_GotKeyboardFocus"
                                       ToolTip="{Binding SelectedChannelRow.ScaleExactDisplay}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,2">
                              <TextBlock DockPanel.Dock="Left" Text="Offset" Style="{StaticResource CanalExpertLabel}"/>
                              <TextBox Style="{StaticResource CanalExpertField}"
                                       Text="{Binding SelectedChannelRow.Offset, UpdateSourceTrigger=LostFocus, StringFormat=0.0}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,2">
                              <TextBlock DockPanel.Dock="Left" Text="Hz" Style="{StaticResource CanalExpertLabel}"/>
                              <TextBox Style="{StaticResource CanalExpertField}"
                                       Text="{Binding SelectedChannelRow.ChannelSampleRateHz, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,2">
                              <TextBlock DockPanel.Dock="Left" Text="Filtru" Style="{StaticResource CanalExpertLabel}"
                                         ToolTip="Cutoff LPF Hz (SoftSetup FI + filtru software). Implicit ≈ Rate/10."/>
                              <TextBox Style="{StaticResource CanalExpertField}"
                                       Text="{Binding SelectedChannelRow.FilterHz, UpdateSourceTrigger=LostFocus}"
                                       ToolTip="Cutoff LPF Hz (SoftSetup FI + filtru software Bessel/Butterworth pe live/Record). Implicit ≈ Rate/10."/>
                            </DockPanel>
                            <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,2">
                              <TextBlock DockPanel.Dock="Left" Text="Exc" Style="{StaticResource CanalExpertLabel}"/>
                              <TextBox Style="{StaticResource CanalExpertField}"
                                       Text="{Binding SelectedChannelRow.ExcitationV, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,2">
                              <TextBlock DockPanel.Dock="Left" Text="Rsh" Style="{StaticResource CanalExpertLabel}"/>
                              <TextBox Style="{StaticResource CanalExpertField}"
                                       Text="{Binding SelectedChannelRow.ShuntKohm, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,0">
                              <TextBlock DockPanel.Dock="Left" Text="Lo" Style="{StaticResource CanalExpertLabel}"/>
                              <TextBox Style="{StaticResource CanalExpertFieldCompact}"
                                       Text="{Binding SelectedChannelRow.AlarmLow, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G5}}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,0">
                              <TextBlock DockPanel.Dock="Left" Text="Hi" Style="{StaticResource CanalExpertLabel}"/>
                              <TextBox Style="{StaticResource CanalExpertFieldCompact}"
                                       Text="{Binding SelectedChannelRow.AlarmHigh, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G5}}"/>
                            </DockPanel>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                </Border>
              </Grid>
            </ctrl:MovableResizableCard>

            <ctrl:MovableResizableCard x:Name="CardSensors" CardId="measure.sensors" Title="Bibliotecă senzori"
                                       Canvas.Left="4" Canvas.Top="528" Width="440" Height="268"
                                       MinWidth="360" MinHeight="200">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" FontSize="12"
                             Text="Click dreapta pe senzor: Apply, Zero/Offset 0, editează, duplică, șterge, detalii."/>
                  <WrapPanel>
                    <ComboBox ItemsSource="{Binding SensorCategories}" SelectedItem="{Binding SelectedSensorCategory}" Width="168" Margin="0,0,8,6" ToolTip="Filtru categorie"/>
                    <TextBox Text="{Binding SensorSearchText, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,6" ToolTip="Caută cod / nume"/>
                    <Button Content="Apply → CH" Command="{Binding ApplySensorCommand}" Margin="0,0,8,6"/>
                    <Menu Style="{StaticResource OverflowMenu}" Margin="0,0,0,6" VerticalAlignment="Center">
                      <MenuItem Header="Mai mult ▾" Style="{StaticResource OverflowMenuItem}">
                        <MenuItem Header="Aplică pe toate On" Command="{Binding ApplySensorAllEnabledCommand}"/>
                        <MenuItem Header="Zero / Offset 0" Command="{Binding ZeroSensorOffsetCommand}"/>
                        <Separator/>
                        <MenuItem Header="Editează senzor" Command="{Binding EditSensorNavigateCommand}"/>
                        <MenuItem Header="Duplică" Command="{Binding DuplicateSensorCommand}"/>
                        <MenuItem Header="Șterge" Command="{Binding DeleteSensorCommand}"/>
                      </MenuItem>
                    </Menu>
                  </WrapPanel>
                </StackPanel>
                <TreeView x:Name="SensorTree" ItemsSource="{Binding SensorGroups}" MinHeight="120"
                          SelectedItemChanged="SensorTree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="SensorTree_PreviewMouseRightButtonDown"
                          ContextMenu="{StaticResource SensorContextMenu}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          BorderThickness="0" Background="Transparent">
                  <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                      <Setter Property="IsExpanded" Value="True"/>
                      <Setter Property="Padding" Value="4,3"/>
                      <Setter Property="Margin" Value="0,1"/>
                      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    </Style>
                  </TreeView.ItemContainerStyle>
                  <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Sensors}">
                      <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Margin="0,0,8,0"
                                   Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                      </StackPanel>
                      <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Border Background="#EEF4FA" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                              <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
