                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="▸ Macrouri" x:Name="MacrosTabItem"
               Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
        <Border Background="{StaticResource PanelBrush}" Margin="4" Padding="14">
          <StackPanel>
            <TextBlock Text="Editor macro" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="Pași: TareAll, WaitMs, Start/Stop Streaming/Recording, Status, LoopStart/End, WaitTrigger, SetSampleRate, ApplyFilters, WaitOperator, Beep."/>
            <WrapPanel>
              <Button Content="Adaugă pas" Command="{Binding AddMacroStepCommand}"/>
              <Button Content="Șterge" Command="{Binding ClearMacroCommand}"/>
              <Button Content="Implicit" Command="{Binding LoadDefaultMacroCommand}"/>
              <Button Content="Job lab" Command="{Binding LoadLabMacroCommand}"/>
              <TextBox Text="{Binding MacroSettleMs}" Width="70" ToolTip="Settle ms default"/>
              <TextBox Text="{Binding MacroRecordMs}" Width="70" ToolTip="Record ms default"/>
