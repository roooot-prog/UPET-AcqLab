                            ToolTip="ν = −dε_t/dε_l pe CursorA–CursorB (sau porțiune timpurie dacă fereastra e scurtă)"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding AnalysisPoissonText}" TextWrapping="Wrap" Margin="0,6,0,0"
                             FontWeight="SemiBold" FontFamily="{StaticResource MeasureMonoFont}"/>
                  <TextBlock Text="Recuperare elastică / ε permanent" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <WrapPanel>
                    <Button Content="Desc. start" Command="{Binding SetUnloadStartCommand}"
                            ToolTip="Marcaj început descărcare la CursorA (ε_max în apropiere)"/>
                    <Button Content="Desc. sfârșit" Command="{Binding SetUnloadEndCommand}"
                            ToolTip="Marcaj sfârșit descărcare la CursorA (ε_end)"/>
                    <Button Style="{StaticResource GhostButton}" Content="Șterge marcaje"
                            Command="{Binding ClearUnloadMarkersCommand}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding ElasticRecoveryText}" TextWrapping="Wrap" Margin="0,6,0,0"
                             FontWeight="SemiBold" FontFamily="{StaticResource MeasureMonoFont}"
                             ToolTip="ε_perm ≈ ε_end − ε₀ · recup. elastică ≈ ε_max − ε_end"/>
                  <TextBlock Text="Adnotări + FFT / CWT regiune" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <WrapPanel>
                    <TextBox Text="{Binding AnnotationText}" Width="120" ToolTip="Text adnotare / marcaj Record"/>
                    <Button Content="Add @" Command="{Binding AddAnnotationCommand}"/>
                    <Button Content="Mark REC" Command="{Binding MarkRecordingCommand}"
                            ToolTip="Scrie # MARK în CSV-ul de înregistrare (Ctrl+Shift+M)"/>
                    <Button Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearAnnotationsCommand}"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="FFT regiune" Command="{Binding FftRegionCommand}"
                            local:HelpTip.Text="FFT pe segmentul CursorA–CursorB."/>
                    <Button Content="CWT regiune" Command="{Binding CwtRegionCommand}"
                            local:HelpTip.Text="Scalogramă CWT (Morlet) pe CursorA–CursorB, canal CH."/>
                    <Button Content="Export spectru" Command="{Binding ExportSpectrumCommand}"/>
                  </WrapPanel>
                  <ListBox ItemsSource="{Binding Annotations}" MaxHeight="80" Margin="0,6,0,0" FontSize="11"/>
                  <ListBox ItemsSource="{Binding PeakIndexes}" MaxHeight="100" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource PanelBrush}" Padding="10">
                <StackPanel>
                  <DataGrid ItemsSource="{Binding AnalysisStats}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="280">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Ch" Binding="{Binding Name}" Width="70"/>
                      <DataGridTextColumn Header="N" Binding="{Binding Count}" Width="40"/>
                      <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="55"/>
                      <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="55"/>
                      <DataGridTextColumn Header="Mean" Binding="{Binding Mean}" Width="55"/>
                      <DataGridTextColumn Header="σ" Binding="{Binding StdDev}" Width="55"/>
                      <DataGridTextColumn Header="RMS" Binding="{Binding Rms}" Width="55"/>
                      <DataGridTextColumn Header="P2P" Binding="{Binding PeakToPeak}" Width="55"/>
                      <DataGridTextColumn Header="Crest" Binding="{Binding Crest}" Width="55"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <Button Content="Copiază stats" Command="{Binding CopyAnalysisStatsCommand}" Margin="0,8,0,0"
                          HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="4"><ScottPlot:WpfPlot x:Name="PlotAnalysis"/></Border>
        </Grid>
      </TabItem>

      <TabItem Header="▸ Dispozitive" x:Name="DevicesTabItem"
               Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
        <Border Background="{StaticResource PanelBrush}" Margin="4" Padding="14">
          <StackPanel>
            <TextBlock Text="Cascade Spider8 slots (1–8)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"
                       Text="Simulator: DeviceCount×8 canale. Serial/DLL: număr total canale. TEDS nu e disponibil pe Spider8 clasic."/>
