                <TextBlock Text="{Binding SelectedDefect.Title}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedDefect.Category}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8"/>
