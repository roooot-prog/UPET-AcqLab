            <ctrl:MovableResizableCard x:Name="CardTools" CardId="measure.tools" Title="Instrumente / meta"
                                       Canvas.Left="4" Canvas.Top="800" Width="440" Height="188"
                                       MinWidth="360" MinHeight="120">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <Expander Style="{StaticResource AiryExpander}" IsExpanded="False" Margin="0,0,0,12">
                    <Expander.Header>
                      <TextBlock Text="Meta sesiune" FontWeight="SemiBold" FontSize="13"/>
                    </Expander.Header>
                    <Border Background="{StaticResource PanelBrush}" Padding="14,12" Margin="0,8,0,0">
                      <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                          <TextBox Text="{Binding OperatorName}" Width="128" Margin="0,0,10,6" ToolTip="Operator"/>
                          <TextBox Text="{Binding SampleId}" Width="128" Margin="0,0,10,6" ToolTip="Sample"/>
                          <TextBox Text="{Binding MaxSeconds}" Width="64" Margin="0,0,8,6" ToolTip="MaxSeconds"/>
                          <TextBlock Text="s max" VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{StaticResource MutedBrush}"/>
                        </WrapPanel>
                        <TextBox Text="{Binding Comment}" ToolTip="Comment"/>
                      </StackPanel>
                    </Border>
                  </Expander>
                  <Expander Style="{StaticResource AiryExpander}" IsExpanded="False" Margin="0,0,0,12">
                    <Expander.Header>
                      <TextBlock Text="Math / Formula" FontWeight="SemiBold" FontSize="13"/>
                    </Expander.Header>
                    <Border Background="{StaticResource PanelBrush}" Padding="12,10" Margin="0,8,0,0">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="Canale math" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddMathCommand}" Margin="0"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding MathChannels}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="140" Margin="0,8,0,0" RowHeight="30">
                          <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Op" Binding="{Binding Operation, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Formula" Binding="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="A" Binding="{Binding SourceA, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                            <DataGridTextColumn Header="B" Binding="{Binding SourceB, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                            <DataGridTextColumn Header="C" Binding="{Binding SourceC, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                          </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Bibliotecă formule" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding FormulaEntries}" SelectedItem="{Binding SelectedFormula}" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SelectedFormula.Expression, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Expresie CHn"/>
                        <WrapPanel>
                          <Button Content="Apply formula" Command="{Binding ApplyFormulaFromLibraryCommand}" Margin="0,0,8,0"/>
                          <Button Style="{StaticResource GhostButton}" Content="Save" Command="{Binding SaveFormulaCommand}" Margin="0,0,8,0"/>
                          <Button Style="{StaticResource GhostButton}" Content="Reload" Command="{Binding ReloadFormulasCommand}"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </Expander>
                  <Expander Style="{StaticResource AiryExpander}" IsExpanded="False" Margin="0,0,0,12"
                            local:HelpTip.Text="Tip afișaj: Y(t), Dual Y(t), Y(X), Poisson (ν), Numeric, Bar, FFT, CWT (scalogramă live per canal On)."
                            xmlns:local="clr-namespace:Spider8DAQ.App">
                    <Expander.Header>
                      <TextBlock Text="Afișaj / trigger" FontWeight="SemiBold" FontSize="13"/>
                    </Expander.Header>
                    <Border Background="{StaticResource PanelBrush}" Padding="12,10" Margin="0,8,0,0">
                      <StackPanel>
                        <TextBlock Text="{Binding PlotModeDescription}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding PlotModes}" SelectedItem="{Binding PlotMode}" Width="160" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,8">
                          <TextBlock Text="Y(X) X" VerticalAlignment="Center"/><TextBox Text="{Binding XyXChannel}" Width="36"/>
                          <TextBlock Text="Y" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox Text="{Binding XyYChannel}" Width="36"/>
                          <TextBlock Text="FFT CH" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox Text="{Binding FftChannel}" Width="36"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                          <TextBlock Text="Poisson ε_l" VerticalAlignment="Center"
                                     ToolTip="Canal longitudinal (CH 1-based)"/>
                          <TextBox Text="{Binding PoissonEpsLChannel}" Width="36" Margin="6,0,0,0"/>
                          <TextBlock Text="ε_t" VerticalAlignment="Center" Margin="10,0,0,0"
                                     ToolTip="Canal transversal (CH 1-based)"/>
                          <TextBox Text="{Binding PoissonEpsTChannel}" Width="36" Margin="6,0,0,0"/>
                          <TextBlock Text="{Binding LivePoissonText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                     FontWeight="SemiBold" FontFamily="{StaticResource MeasureMonoFont}"
                                     ToolTip="ν aparent live (regresie pe porțiunea timpurie a bufferului)"/>
                        </WrapPanel>
                        <WrapPanel>
                          <ComboBox ItemsSource="{Binding RecordStopModes}" SelectedItem="{Binding RecordStopMode}" Width="110"/>
                          <TextBox Text="{Binding MaxSeconds}" Width="44" ToolTip="MaxSeconds" Margin="4,0,0,0"/>
                          <TextBox Text="{Binding MaxSamples}" Width="56" ToolTip="MaxSamples" Margin="4,0,0,0"/>
                          <TextBlock Text="Prag" VerticalAlignment="Center" Margin="8,0,4,0" ToolTip="Oprire Threshold"/>
                          <TextBox Text="{Binding RecordThresholdValue}" Width="56" ToolTip="ThresholdValue (|val| ≥ prag)"/>
                          <TextBlock Text="CH#" VerticalAlignment="Center" Margin="6,0,2,0"/>
                          <TextBox Text="{Binding RecordThresholdChannel}" Width="28" ToolTip="Index canal 0-based pentru Threshold"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                          <TextBlock Text="Stocare" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <ComboBox ItemsSource="{Binding StorageModes}" SelectedItem="{Binding StorageMode}" Width="110"
                                    ToolTip="Full = fiecare eșantion; PeakInterval = Min/Max pe interval"/>
                          <TextBox Text="{Binding PeakIntervalSeconds}" Width="44" Margin="4,0,0,0" ToolTip="Interval Peak (s)"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                          <CheckBox Content="Stats journal" IsChecked="{Binding StatsJournalEnabled}"/>
                          <TextBox Text="{Binding StatsIntervalSeconds}" Width="40" ToolTip="Interval s" Margin="4,0,0,0"/>
                          <CheckBox Content="Stop on alarm" IsChecked="{Binding StopRecordOnAlarm}" Margin="8,0,0,0"/>
                          <CheckBox Content="Linie Zero" IsChecked="{Binding PlotShowZeroLine}" Margin="8,0,0,0"/>
                          <CheckBox Content="Linie prag" IsChecked="{Binding PlotShowThresholdLine}" Margin="8,0,0,0"/>
                          <CheckBox Content="Linie MARK" IsChecked="{Binding PlotShowLastMarkLine}" Margin="8,0,0,0"/>
                          <CheckBox Content="Multi-panel" IsChecked="{Binding MultiPanelMode}" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding StatsJournalStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0">
                          <CheckBox Content="Level trigger" IsChecked="{Binding TriggerEnabled}"/>
                          <TextBox Text="{Binding TriggerChannel}" Width="36" Margin="4,0,0,0"/>
                          <TextBox Text="{Binding TriggerThreshold}" Width="70" Margin="4,0,0,0"/>
                          <CheckBox Content="Rising" IsChecked="{Binding TriggerRising}" Margin="4,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                          <TextBlock Text="PreTrig" VerticalAlignment="Center"/><TextBox Text="{Binding PreTriggerSamples}" Width="50" Margin="4,0,0,0"/>
                          <CheckBox Content="Append" IsChecked="{Binding AppendMode}" Margin="8,0,0,0"/>
                          <CheckBox Content="Auto name" IsChecked="{Binding AutoFileName}" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <Border Background="#F0F4F8" Padding="10,8" Margin="0,10,0,0" CornerRadius="4"
                                BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1">
                          <StackPanel>
                            <CheckBox Content="Cadrane gradate live" IsChecked="{Binding ShowLiveGauge}" FontWeight="SemiBold"/>
                            <Button Content="Adaugă cadran" Command="{Binding AddLiveGaugeCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,8"
                                    ToolTip="Adaugă cadran mobil pe spațiul de lucru"/>
                            <DockPanel Margin="0,0,0,4" IsEnabled="{Binding ShowLiveGauge}">
                              <TextBlock Text="Canal (primul cadran)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                              <ComboBox ItemsSource="{Binding LiveGaugeChannelOptions}"
                                        SelectedValue="{Binding LiveGaugeChannelIndex, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Index" DisplayMemberPath="Label" Width="150"/>
                            </DockPanel>
                            <TextBlock Text="Mod afișare: pe fiecare cadran (listă filtrată după senzorul canalului)."
                                       FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Margin="0,8,0,4" IsEnabled="{Binding ShowLiveGauge}"/>
                            <DockPanel Margin="0,0,0,4" IsEnabled="{Binding ShowLiveGauge}"
                                       Visibility="{Binding ShowPressureToKgOption, Converter={StaticResource BoolToVis}}">
                              <TextBlock Text="Aria piston (cm²)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                              <TextBox Text="{Binding PistonAreaCm2, UpdateSourceTrigger=PropertyChanged}" Width="72"
                                       ToolTip="UPET presă hidraulică: 201,06 cm²"/>
                            </DockPanel>
                            <TextBlock Text="{Binding LiveGaugeFormulaHint}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </Expander>
                  <ItemsControl ItemsSource="{Binding LiveValues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="6,4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1" CornerRadius="3">
                          <DockPanel>
                            <TextBlock Text="{Binding Name}" Width="96" FontWeight="SemiBold"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Width="50" TextAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Display}" FontFamily="{StaticResource MeasureMonoFont}" FontSize="18" FontWeight="SemiBold"/>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </ctrl:MovableResizableCard>

            <ctrl:MovableResizableCard x:Name="CardWorkflow" CardId="measure.workflow" Title="Ghid operator — flux măsurătoare"
                                       Canvas.Left="728" Canvas.Top="564" Width="500" Height="188"
                                       MinWidth="320" MinHeight="160">
              <StackPanel>
                <TextBlock Text="{Binding SelectedWorkflow.Description}" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding WorkflowTemplates}" SelectedValue="{Binding SelectedWorkflowId}"
                          SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,0,8"
                          ToolTip="Alegeți tipul de măsurătoare (tensometrie, presă hidraulică…)"/>
                <ItemsControl ItemsSource="{Binding WorkflowSteps}" Margin="0,0,0,10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="18" FontFamily="Consolas"
                                   FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                          <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                  <Button Content="Aplică preset" Command="{Binding ApplyWorkflowPresetCommand}" Margin="0,0,8,0"/>
                  <Button Style="{StaticResource GhostButton}" Content="Sincronizează" Command="{Binding SyncWorkflowCommand}"/>
                </WrapPanel>
              </StackPanel>
            </ctrl:MovableResizableCard>

            <ctrl:MovableResizableCard x:Name="CardPlot" CardId="measure.plot" Title="Grafic live"
                                       Canvas.Left="728" Canvas.Top="4" Width="740" Height="556"
                                       MinWidth="420" MinHeight="280" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition x:Name="PlotSplitterRow" Height="6"/>
              <RowDefinition x:Name="PlotRowB" Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1,1,1,0"
                    Padding="8,6" Margin="0,0,0,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource GhostButton}" Content="✕" Command="{Binding HideLivePlotCardCommand}"
                          Padding="6,4" Margin="0,0,6,0" ToolTip="Ascunde Grafic live"/>
                  <Button Style="{StaticResource GhostButton}" Content="Panou canal" Command="{Binding AddChannelPlotCommand}"
                          Padding="8,4" Margin="0,0,6,0"
                          ToolTip="Deschide grafic Y(t) separat pentru canalul selectat"/>
                  <Button Style="{StaticResource GhostButton}" Content="Autoscale" Command="{Binding AutoscalePlotsCommand}" Padding="8,4" Margin="0,0,6,0"
                          ToolTip="Autoscale comun — Grafic live + toate panourile canal"/>
                  <Button Style="{StaticResource GhostButton}" Content="Reset zoom" Command="{Binding ResetPlotZoomCommand}" Padding="8,4" Margin="0,0,10,0"/>
                  <CheckBox Content="Urmărește live" IsChecked="{Binding FollowLiveZoom}" VerticalAlignment="Center"
                            ToolTip="Urmărire live comună (Y auto) pentru stiva de grafice — nu pe fiecare panou"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" Foreground="{StaticResource AccentBrush}"
                             FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding PlotMode}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Text="{Binding PlotModeDescription}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                  <TextBlock Text="{Binding LivePoissonText}" FontWeight="SemiBold" FontSize="12"
                             FontFamily="{StaticResource MeasureMonoFont}" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="PlotHostA" Grid.Row="1" Margin="0,4,0,0"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushUi}"
                    BorderThickness="1" Padding="3" CornerRadius="2">
              <ScottPlot:WpfPlot x:Name="PlotA"/>
            </Border>

            <Border x:Name="PlotHostB" Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushUi}"
                    BorderThickness="1" Padding="3" CornerRadius="2"><ScottPlot:WpfPlot x:Name="PlotB"/></Border>
            <ScrollViewer x:Name="CwtHost" Grid.Row="1" Grid.RowSpan="3" Margin="0,8,0,0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F4F7FA" Padding="12,8" Margin="0,0,0,6"
                        BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1" CornerRadius="4">
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                             Text="Analiză timp-frecvență (CWT) live HQ — Morlet Smooth, câte un scalogram per canal On. Refresh ~15–20 Hz (adaptiv), fereastră glisantă (nu așteaptă buffer plin)."/>
                </Border>
                <ItemsControl ItemsSource="{Binding LiveCwtPanels}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </DockPanel>
            </ScrollViewer>
            <Border x:Name="NumericHost" Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource BgBrush}" Padding="20" Visibility="Collapsed">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Afișaj numeric" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding LiveValues}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,14,14" Padding="18,14" MinWidth="180" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1" CornerRadius="4">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Display}" FontFamily="{StaticResource MeasureMonoFont}" FontSize="36" FontWeight="Bold" Margin="0,10,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                      <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
            </ctrl:MovableResizableCard>

            <ItemsControl ItemsSource="{Binding LiveGauges}"
                          Visibility="{Binding ShowLiveGauge, Converter={StaticResource BoolToVis}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                  <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                  <Setter Property="Panel.ZIndex" Value="30"/>
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding ChannelPlots}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                  <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                  <Setter Property="Panel.ZIndex" Value="28"/>
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ItemsControl>
          </Canvas>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

