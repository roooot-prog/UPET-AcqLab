                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" FontSize="12"
                           Text="Exemple tipice Spider8/lab — selectați pentru semnal demonstrativ și pași de remediere."/>
              </StackPanel>
              <ListBox ItemsSource="{Binding DefectCatalogItems}" SelectedItem="{Binding SelectedDefect}"
