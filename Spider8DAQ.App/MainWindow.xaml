          <ScrollViewer>
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Job măsurătoare" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,8"
                           Text="Flux laborator UPET: meta → rată/filtru → senzori → Connect/Start → tare → Record → vizualizare/raport."/>
                <TextBlock Text="{Binding JobStatusSummary}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding JobChecklist}" FontFamily="Consolas" FontSize="13" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button Content="Pas înapoi" Command="{Binding JobPrevCommand}"/>
                  <Button Content="Pas următor" Command="{Binding JobNextCommand}"/>
                  <Button Content="Sincronizează checklist" Command="{Binding JobSyncChecklistCommand}"/>
                  <Button Content="Aplică rată/filtru" Command="{Binding JobApplyRateFilterCommand}"
                          local:HelpTip.Text="SampleRateHz + JobFilterHz pe canalele activate."/>
                  <Button Content="Tare + Record job" Command="{Binding JobRunRecordCommand}"/>
                  <Button Content="Descarcă CSV…" Command="{Binding DownloadCsvCommand}"/>
                  <Button Style="{StaticResource GhostButton}" Content="Folder CSV" Command="{Binding OpenCsvFolderCommand}"/>
                  <Button Content="Aplică vizualizare" Command="{Binding JobApplyVizCommand}"
                          local:HelpTip.Text="Aplică tipul de afișaj din presetul Experiment."/>
                  <Button Content="Raport HTML" Command="{Binding JobExportReportCommand}"/>
                  <Button Style="{StaticResource GhostButton}" Content="Export PDF" Command="{Binding ExportPdfCommand}"/>
                  <Button Content="Raport industrial (PDF)" Command="{Binding ExportIndustrialReportCommand}"
                          ToolTip="PDF 1–2 pagini tip laborator metrologic industrial"/>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                  <TextBlock Text="Rată Hz" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding SampleRateHz}" Width="56" Margin="8,0,0,0"/>
                  <TextBlock Text="Filtru Hz" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <TextBox Text="{Binding JobFilterHz}" Width="56" Margin="8,0,0,0"/>
                  <TextBlock Text="Oprire" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <ComboBox ItemsSource="{Binding RecordStopModes}" SelectedItem="{Binding RecordStopMode}" Width="100" Margin="8,0,0,0"/>
                  <TextBlock Text="Prag" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <TextBox Text="{Binding RecordThresholdValue}" Width="56" Margin="8,0,0,0"/>
                  <TextBlock Text="CH#" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBox Text="{Binding RecordThresholdChannel}" Width="36" Margin="8,0,0,0"/>
                  <TextBlock Text="MaxSeconds" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <TextBox Text="{Binding MaxSeconds}" Width="60" Margin="8,0,0,0"/>
                  <TextBlock Text="Stocare" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <ComboBox ItemsSource="{Binding StorageModes}" SelectedItem="{Binding StorageMode}" Width="110" Margin="8,0,0,0"/>
                  <TextBox Text="{Binding PeakIntervalSeconds}" Width="48" Margin="8,0,0,0" ToolTip="Peak interval (s)"/>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                  <TextBlock Text="Operator" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding OperatorName}" Width="120" Margin="8,0,0,0"/>
                  <TextBlock Text="Sample" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <TextBox Text="{Binding SampleId}" Width="120" Margin="8,0,0,0"/>
                  <TextBlock Text="Afișaj" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <ComboBox ItemsSource="{Binding PlotModes}" SelectedItem="{Binding PlotMode}" Width="120" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBox Text="{Binding Comment}" Margin="0,10,0,0" AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                         ToolTip="Descriere măsurătoare / condiții experiment"/>
                <TextBlock Text="Proiecte exemplu UPET" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <WrapPanel>
                  <ComboBox ItemsSource="{Binding ExampleProjects}" SelectedItem="{Binding SelectedExample}" Width="120"/>
                  <Button Content="Încarcă exemplu" Command="{Binding LoadExampleProjectCommand}"/>
                  <Button Content="Preflight" Command="{Binding PreflightCommand}"/>
                  <Button Content="Multi-panel" Command="{Binding ToggleMultiPanelCommand}"/>
                  <Button Content="Macro job lab" Command="{Binding LoadLabMacroCommand}"
                          local:HelpTip.Text="Încarcă secvența macro: rată → filtru → tare → record."/>
                </WrapPanel>
                <TextBlock Text="{Binding StatsJournalStatus}" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding PreflightLines}" MaxHeight="140" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11"/>
              </StackPanel>
            </DockPanel>
          </ScrollViewer>
        </Border>
      </TabItem>

      <TabItem Header="Analiză" x:Name="AnalysisTabItem">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ScrollViewer>
            <StackPanel>
              <Border Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                  <WrapPanel>
                    <Button Content="Load CSV" Command="{Binding LoadAnalysisCommand}"/>
                    <Button Content="Open .upet" Command="{Binding OpenUpetReportCommand}"
                            ToolTip="Deschide raport proprietar UPET AcqLab"/>
                    <Button Content="Import Matest" Command="{Binding ImportMatestCommand}"/>
                    <Button Content="Save CSV" Command="{Binding SaveAnalysisCsvCommand}"/>
                    <Button Content="Export region" Command="{Binding ExportRegionCommand}"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="Export .upet" Command="{Binding ExportUpetReportCommand}"
                            ToolTip="Salvează raport binar criptat — doar UPET AcqLab îl citește"/>
                    <Button Content="Pachet lab" Command="{Binding ExportLabPackageCommand}"
                            ToolTip="ZIP / .upetlab: README + CSV + poze + rapoarte"/>
                    <Button Content="Open pachet" Command="{Binding OpenLabPackageCommand}"/>
                    <Button Content="TXT" Command="{Binding ExportAnalysisTxtCommand}"/>
                    <Button Content="MAT" Command="{Binding ExportAnalysisMatCommand}"/>
                    <Button Content="Excel" Command="{Binding ExportAnalysisExcelCommand}"/>
                    <Button Content="Raport industrial (PDF)" Command="{Binding ExportIndustrialReportCommand}"
                            ToolTip="PDF industrial: identitate, probă, zonă A–B, rezultate, semnaturi"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding AnalysisSummary}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
