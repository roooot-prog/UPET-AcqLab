                <TextBlock Text="{Binding DefectScanSummary}" TextWrapping="Wrap" Margin="0,4,0,8"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <WrapPanel>
                  <Button Content="Scanează acum" Command="{Binding ScanDefectsNowCommand}" Margin="0,0,8,4"/>
                  <Button Content="Scanează Analiză" Command="{Binding ScanOfflineDefectsCommand}" Margin="0,0,8,4"/>
                  <Button Style="{StaticResource GhostButton}" Content="Golește lista"
                          Command="{Binding ClearMistakeFindingsCommand}" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                           Text="Live: la fiecare ~2,5 s în timpul Start. Mesaje clare (Zero uitat, polaritate, canal greșit, drift, saturare, cablu, șunt, presiune fără Zero) — nu înlocuiesc alarmele Lo/Hi."/>
              </StackPanel>
              <ListBox ItemsSource="{Binding LiveMistakeFindings}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="6" Margin="0,0,0,6" Background="#E8EEF4">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="{Binding SeverityLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                     DockPanel.Dock="Right"/>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                          <Run Text="{Binding ChannelHint}"/>
                          <Run Text=" · "/>
                          <Run Text="{Binding WhenLocal}"/>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

