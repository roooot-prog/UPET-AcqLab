                <WrapPanel>
                  <TextBlock Text="Edit" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Text="{Binding EditSensorName, UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="Nume"/>
                  <TextBox Text="{Binding EditSensorUnit, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0,0,0" ToolTip="Unit"/>
                  <TextBox Text="{Binding EditSensorScale, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0,0,0" ToolTip="Scale"/>
                  <TextBox Text="{Binding EditSensorBridge, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="8,0,0,0" ToolTip="Punte"/>
                  <TextBox Text="{Binding EditSensorExcitationV, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0,0,0" ToolTip="Excitație V"/>
                  <TextBox Text="{Binding EditSensorShuntKohm, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="8,0,0,0" ToolTip="R-Shunt kΩ"/>
                  <TextBox Text="{Binding EditSensorNotes, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="8,0,0,0" ToolTip="Note"/>
                  <Button Content="Update" Command="{Binding UpdateSensorCommand}" Margin="12,0,0,0"/>
                </WrapPanel>
              </Border>
              <Border Background="#F0F7F4" BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,8,0,4">
                <StackPanel>
                  <TextBlock Text="Timbru / punte tensometrică" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                             Text="Pentru lab: folosește «Asistent Timbru» (alegi tipul experimentului → completează GF → Configurează automat)."/>
                  <WrapPanel Margin="0,0,0,8">
                    <Button Content="Asistent Timbru (ușor)" Command="{Binding TimbruQuickSetupCommand}"
                            FontWeight="SemiBold" Padding="12,6" Margin="0,0,10,0"
                            ToolTip="Wizard: activ + timbru pasiv (compensare T°), Poisson, încovoiere — setează Scale și aplică pe canal"/>
                    <Button Style="{StaticResource GhostButton}" Content="Arată cablare" Command="{Binding TimbruShowWiringCommand}"/>
                  </WrapPanel>
                  <WrapPanel>
                    <TextBlock Text="Canal CH#" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TimbruChannelUi}" Width="40" Margin="6,0,12,0" ToolTip="CH0…CH7 — același index ca în grila Măsurare"/>
                    <TextBlock Text="Tip punte" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding TimbruBridgeTypes}" SelectedItem="{Binding TimbruBridge}" Width="90" Margin="6,0,12,0"/>
                    <TextBlock Text="GF" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TimbruGaugeFactor}" Width="48" Margin="6,0,12,0" ToolTip="Gauge Factor"/>
                    <TextBlock Text="R Ω" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TimbruResistanceOhm}" Width="56" Margin="6,0,12,0" ToolTip="Rezistență timbru"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="Comp. Quarter Ω" VerticalAlignment="Center" Visibility="{Binding TimbruShowQuarterComp, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox ItemsSource="{Binding TimbruQuarterCompOptions}" SelectedItem="{Binding TimbruQuarterCompOhm}" Width="70" Margin="6,0,12,0"
                              Visibility="{Binding TimbruShowQuarterComp, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Config Half" VerticalAlignment="Center" Visibility="{Binding TimbruShowHalfConfig, Converter={StaticResource BoolToVis}}"
