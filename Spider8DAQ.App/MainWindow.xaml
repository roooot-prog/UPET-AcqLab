                    <ComboBox ItemsSource="{Binding TimbruHalfConfigs}" SelectedItem="{Binding TimbruHalfConfig}" Width="220" Margin="6,0,12,0"
                              Visibility="{Binding TimbruShowHalfConfig, Converter={StaticResource BoolToVis}}"
                              ToolTip="Activ + timbru pasiv (compensare T°): activ pe grindă + pasiv pe placă, același canal"/>
                    <TextBlock Text="ν" VerticalAlignment="Center" Visibility="{Binding TimbruShowPoissonNu, Converter={StaticResource BoolToVis}}" ToolTip="PoissonRatio"/>
                    <TextBox Text="{Binding TimbruPoissonRatio}" Width="48" Margin="6,0,12,0"
                             Visibility="{Binding TimbruShowPoissonNu, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Scale=" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TimbruComputedScale, StringFormat=0.####}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock Text="µm/m · Exc 2.5 V · Filtru 5 Hz" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="Calculează Scale" Command="{Binding TimbruCalculateScaleCommand}" Margin="0,0,8,0"/>
                    <Button Content="Aplică pe canal" Command="{Binding TimbruApplyChannelCommand}" Margin="0,0,8,0"/>
                    <CheckBox Content="Autorange" IsChecked="{Binding TimbruAutorange}" VerticalAlignment="Center"
                              Margin="8,0,0,0" FontWeight="SemiBold"
                              ToolTip="Alege automat domeniul µm/m înainte de Record, după vârful din live / fișa de epruvetă. În Rec domeniul rămâne blocat (nu e AGC). La saturație: Overflow, nu schimbă treapta din mers."/>
                    <TextBlock Text="{Binding TimbruAutorangeDomain, StringFormat=domeniu {0:0} µm/m}"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding TimbruShowAutorangeDomain, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Diferență permisă %" VerticalAlignment="Center" Margin="16,0,6,0"
                               ToolTip="catman Easy: 0.5–5% din treapta de shunt așteptată (tipic 0.5%)."/>
                    <ComboBox ItemsSource="{Binding ShuntAllowedDifferenceOptions}"
                              SelectedItem="{Binding ShuntAllowedDifferencePercent, UpdateSourceTrigger=PropertyChanged}"
                              Width="64" VerticalAlignment="Center"
                              ItemStringFormat="{}{0:0.##}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding TimbruStatus}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.4*"/>
              </Grid.ColumnDefinitions>
              <TreeView x:Name="SensorLibraryTree" ItemsSource="{Binding SensorGroups}"
                        SelectedItemChanged="SensorTree_SelectedItemChanged"
                        PreviewMouseRightButtonDown="SensorTree_PreviewMouseRightButtonDown"
                        ContextMenu="{StaticResource SensorContextMenu}"
                        Padding="8,6">
                <TreeView.ItemContainerStyle>
                  <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                    <Setter Property="Padding" Value="4,3"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                  </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Sensors}">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2"/>
                    <HierarchicalDataTemplate.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                          <Border Background="#EEF4FA" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                          </Border>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <DataGrid Grid.Column="2" ItemsSource="{Binding SensorRows}" SelectedItem="{Binding SelectedSensorRow}"
                        AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="32"
                        ContextMenu="{StaticResource SensorContextMenu}"
                        PreviewMouseRightButtonDown="SensorGrid_PreviewMouseRightButtonDown">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Cod" Binding="{Binding Code}" Width="80"/>
                  <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="150"/>
                  <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="170"/>
                  <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55"/>
                  <DataGridTextColumn Header="Capacitate" Binding="{Binding Capacity}" Width="80"/>
                  <DataGridTextColumn Header="Punte" Binding="{Binding Bridge}" Width="80"/>
                  <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="60"/>
                  <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="60"/>
                  <DataGridTextColumn Header="Exc V" Binding="{Binding ExcitationV}" Width="55"/>
                  <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </DockPanel>
        </Border>
      </TabItem>

      <TabItem Header="Job" x:Name="JobTabItem"
               Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">
