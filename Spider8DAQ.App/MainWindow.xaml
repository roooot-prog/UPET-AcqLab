<Window x:Class="Spider8DAQ.App.MainWindow"
        x:Name="RootWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Spider8DAQ.App"
        xmlns:ctrl="clr-namespace:Spider8DAQ.App.Controls"
        xmlns:vm="clr-namespace:Spider8DAQ.App.ViewModels"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="UPET AcqLab — Universitatea din Petroșani"
        Height="940" Width="1480"
        MinHeight="720" MinWidth="1180"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <local:BindingProxy x:Key="VmProxy"/>
    <ContextMenu x:Key="SensorContextMenu" x:Shared="false"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Aplică pe canalul selectat" Command="{Binding ApplySensorCommand}"/>
      <MenuItem Header="Aplică pe toate canalele On" Command="{Binding ApplySensorAllEnabledCommand}"/>
      <Separator/>
      <MenuItem Header="Zero / Offset 0" Command="{Binding ZeroSensorOffsetCommand}"/>
      <Separator/>
      <MenuItem Header="Editează senzor" Command="{Binding EditSensorNavigateCommand}"/>
      <MenuItem Header="Duplică" Command="{Binding DuplicateSensorCommand}"/>
      <MenuItem Header="Șterge" Command="{Binding DeleteSensorCommand}"/>
      <Separator/>
      <MenuItem Header="Copiază cod" Command="{Binding CopySensorCodeCommand}"/>
      <MenuItem Header="Copiază cod / nume" Command="{Binding CopySensorNameCommand}"/>
      <Separator/>
      <MenuItem Header="Detalii" Command="{Binding ShowSensorDetailsCommand}"/>
    </ContextMenu>
    <ContextMenu x:Key="ChannelContextMenu" x:Shared="false"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Zero CH" Command="{Binding TareSelectedCommand}"/>
      <MenuItem Header="Shunt CH" Command="{Binding ShuntSelectedCommand}"/>
      <MenuItem Header="Aplică Scale din shunt" Command="{Binding ApplyScaleFromShuntCommand}"
                ToolTip="Doar după Shunt CH PASS (sau ±20%) pe canal µm/m, cu confirmare. Nu se aplică silent."/>
      <MenuItem Header="Inversare polaritate (Scale × −1)" Command="{Binding InvertSelectedChannelPolarityCommand}"
                ToolTip="Celulă de forță în compresie cu semn −: inversați polaritatea, apoi Zero CH fără sarcină."/>
      <MenuItem Header="Undo canal" Command="{Binding UndoChannelEditCommand}" InputGestureText="Ctrl+Z"
                ToolTip="Anulează ultima modificare Scale/Zero/polaritate pe canal"/>
      <Separator/>
      <MenuItem Header="Aplică senzorul selectat" Command="{Binding ApplySensorCommand}"/>
      <MenuItem Header="Comută alarmă CH" Command="{Binding ToggleSelectedChannelAlarmCommand}"/>
      <MenuItem Header="Resetează offset CH" Command="{Binding ResetSelectedChannelOffsetCommand}"/>
      <MenuItem Header="Șterge Soft Zero pe toate" Command="{Binding ResetAllSoftZeroCommand}"/>
      <Separator/>
      <MenuItem Header="Verificare senzor CH" Command="{Binding VerifySensorCommand}"/>
      <Separator/>
      <MenuItem Header="Deschide grafic separat" Command="{Binding OpenSeparatePlotForSelectedCommand}"
                ToolTip="Panou Y(t) mobil doar pentru canalul selectat (fără suprapunere cu celelalte)."/>
      <Separator/>
      <MenuItem Header="Redenumește…" Command="{Binding RenameSelectedChannelCommand}"
                ToolTip="Editați coloana Nume din grilă (dublu-click)."/>
    </ContextMenu>
    <DataTemplate DataType="{x:Type vm:LiveGaugeItemViewModel}">
      <ctrl:LiveGaugeCard Width="{Binding Width}" Height="{Binding Height}">
        <!-- No ScrollViewer: all chrome + dial must fit the card at default size. -->
        <Grid Margin="2,0,2,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Command="{Binding RemoveCommand}" Content="✕" Padding="6,1" Margin="4,0,0,0"
                    ToolTip="Elimină cadranul" FontSize="11" VerticalAlignment="Center"/>
            <ComboBox DockPanel.Dock="Right" Width="150" Margin="6,0,0,0"
                      ItemsSource="{Binding AvailableDisplayModes}"
                      SelectedValue="{Binding DisplayMode, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Id" DisplayMemberPath="Label"
                      FontSize="11" VerticalAlignment="Center"
                      ToolTip="Moduri disponibile pentru tipul de senzor de pe canal"/>
            <ComboBox ItemsSource="{Binding DataContext.LiveGaugeChannelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValue="{Binding ChannelIndex, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Index" DisplayMemberPath="Label"
                      FontSize="11" VerticalAlignment="Center" MinWidth="72"/>
          </DockPanel>
          <TextBlock Grid.Row="1" Text="{Binding ChannelLabel}" FontSize="10"
                     Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                     Margin="0,0,0,2"/>
          <ctrl:RadialGaugeControl Grid.Row="2"
                                   Value="{Binding Value, Mode=OneWay}"
                                   Minimum="{Binding GaugeMin, Mode=OneWay}"
                                   Maximum="{Binding GaugeMax, Mode=OneWay}"
                                   Unit="{Binding Unit, Mode=OneWay}" TickCount="21"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   MinHeight="120"/>
          <StackPanel Grid.Row="3" Margin="0,2,0,0">
            <TextBlock Text="{Binding SourceBarDisplay, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                       HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                       Visibility="{Binding ShowPressureDual, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding SecondaryDisplay, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                       HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                       Visibility="{Binding ShowForceDual, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="9" HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding ShowSecondaryLine, Converter={StaticResource BoolToVis}}"/>
            <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
              <CheckBox Content="Scară auto" IsChecked="{Binding AutoScale}" FontSize="10" VerticalAlignment="Center"
                        ToolTip="Debifat: scară manuală GaugeMin/Max"/>
              <TextBox Text="{Binding GaugeMin, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="52" Margin="6,0,2,0"
                       FontFamily="{StaticResource MeasureMonoFont}" FontSize="10" ToolTip="GaugeMin"/>
              <TextBlock Text="…" VerticalAlignment="Center" FontSize="10"/>
              <TextBox Text="{Binding GaugeMax, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="52" Margin="2,0,0,0"
                       FontFamily="{StaticResource MeasureMonoFont}" FontSize="10" ToolTip="GaugeMax"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </ctrl:LiveGaugeCard>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LiveChannelPlotItemViewModel}">
      <ctrl:LiveChannelPlotCard Width="{Binding Width}" Height="{Binding Height}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="0,0,0,1"
                  Padding="8,6">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                      Command="{Binding RemoveCommand}" Content="✕" Padding="8,2" Margin="4,0,0,0"
                      ToolTip="Închide panoul grafic" FontSize="11"/>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="Autoscale / Urmărește live — pe antetul comun al Grafic live"/>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushUi}"
                  BorderThickness="1" Padding="4" Margin="4">
            <ScottPlot:WpfPlot/>
          </Border>
        </Grid>
      </ctrl:LiveChannelPlotCard>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LiveCwtPanelViewModel}">
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="2"
              CornerRadius="4" Margin="4" MinHeight="240" MinWidth="320">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource PanelAltBrush}" Padding="10,6" BorderBrush="{Binding AccentBrush}"
                  BorderThickness="0,0,0,2">
            <DockPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                         Foreground="{Binding AccentBrush}"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}"
                         FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
          </Border>
          <ctrl:LiveCwtPlotHost/>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Grid DockPanel.Dock="Top" Height="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#002B7F"/>
      <Border Grid.Column="1" Background="#FCD116"/>
      <Border Grid.Column="2" Background="#CE1126"/>
    </Grid>
    <Border DockPanel.Dock="Top" Background="{StaticResource RibbonBrush}" BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="0,0,0,1">
      <StackPanel>
        <!-- Bandă brand + toolbar fix (stil aplicație inginerească) -->
        <DockPanel Margin="8,3,8,3" LastChildFill="False" VerticalAlignment="Center" Height="56">
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushUi}" BorderThickness="1"
                  CornerRadius="2" Padding="2" Margin="0,0,6,0" DockPanel.Dock="Left"
                  VerticalAlignment="Center" Height="52" Width="52"
                  SnapsToDevicePixels="True">
            <Image Source="pack://application:,,,/Assets/upet-logo.png"
                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="UNIVERSITATEA DIN PETROȘANI" FontSize="8" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" LineHeight="10"/>
            <TextBlock Text="UPET AcqLab" FontSize="14" FontWeight="Bold" LineHeight="17"/>
            <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource MutedBrush}"
                       FontSize="9" LineHeight="12" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton Style="{StaticResource HmiToggle}" IsChecked="{Binding IsExpertMode}"
                          ToolTip="Operator: Start/Stop/Rec/Zero/Conn. Expert: driver, Scale exact, Rsh, OMB/Hz, coloane extra.">
              <TextBlock Text="Expert"/>
            </ToggleButton>
            <ToggleButton Style="{StaticResource HmiToggle}" IsChecked="{Binding IsDarkTheme}"
                          ToolTip="Dark laborator — crom antracit, cifre chihlimbar.">
              <TextBlock Text="Dark laborator"/>
            </ToggleButton>
            <Button Style="{StaticResource GhostButton}" Content="Verifică actualizări"
                    Command="{Binding CheckUpdatesCommand}" Margin="8,0,0,0" Padding="8,4"
                    Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}"
                    ToolTip="GitHub public: compară FileVersion cu releases/latest."/>
            <Ellipse Width="12" Height="12" Margin="8,0,4,0" Fill="#C8102E"
                     Visibility="{Binding ShowRecDot, Converter={StaticResource BoolToVis}}"
                     ToolTip="Înregistrare activă"/>
            <TextBlock Text="REC" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#C8102E"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowRecDot, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <!-- Acțiuni: grupuri PROIECT / EXPORT și AJUTOR din banda SPAȚIU DE LUCRU (jos). -->
        </DockPanel>

        <StackPanel Margin="8,3,8,4">
            <!-- Full-width machine state — short copy; serial/DEST in tooltip -->
            <Border Style="{StaticResource StatusBand}" Background="{Binding MachineStateBrush}"
                    ToolTip="{Binding MachineBandTooltip}" Margin="0,0,0,6">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="{Binding DeviceErrorBrush}" CornerRadius="2"
                        Padding="6,1" Margin="8,0,0,0" MinWidth="64" VerticalAlignment="Center"
                        ToolTip="Stare EST / LED ERROR Spider8">
                  <TextBlock Text="{Binding DeviceErrorText}" Foreground="White" FontSize="10"
                             FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding HardwareSummary}" Foreground="#F7F3EC"
                           FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="200"
                           ToolTip="{Binding HardwareSummary}" Opacity="0.95"
                           Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding MachineStateHeadline}" Foreground="White" FontWeight="Bold"
                           FontSize="14" FontFamily="Consolas" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>

            <!-- Compact Citire: On chips clustered+centered (no 280px hero void). -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Center" Margin="0,0,0,6">
              <ItemsControl ItemsSource="{Binding Channels}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border>
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource LiveStripChip}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                                 Fill="{Binding ChannelLedBrush}" VerticalAlignment="Center"
                                 ToolTip="{Binding ChannelLedTooltip}"/>
                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LiveReading}" Style="{StaticResource MeasureDigits}"
                                   FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CitireUnitDisplay}" Style="{StaticResource MeasureUnitText}"
                                   FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Left-aligned Conn cluster + Start/Stop/Rec/Zero. Operator: port + Conn only. -->
            <StackPanel Margin="0,0,0,2" xmlns:local="clr-namespace:Spider8DAQ.App">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ComboBox Style="{StaticResource RibbonFieldCombo}" ItemsSource="{Binding Backends}"
                                SelectedItem="{Binding SelectedBackend}" MinWidth="100"
                                ToolTip="Backend: Simulator / Serial / Spider32 / HBM USB"
                                Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}"/>
                      <ComboBox Style="{StaticResource RibbonFieldCombo}" ItemsSource="{Binding Ports}"
                                SelectedItem="{Binding SelectedPort}" MinWidth="90"
                                ToolTip="Port COM sau țintă USBHBM"/>
                      <TextBox Style="{StaticResource RibbonFieldText}" Text="{Binding SampleRateHz}" Width="52"
                               ToolTip="Rată eșantionare [Hz]"
                               Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}"/>
                      <Button Command="{Binding ConnectCommand}"
                              ToolTip="Conectare dispozitiv">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource PrimaryOpButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Conn" FontWeight="SemiBold"/>
                      </Button>
                      <Button Command="{Binding DisconnectCommand}"
                              ToolTip="Deconectare (Spider8 rămâne alimentat)">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource PrimaryOpButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="#C62828"/>
                            <Setter Property="BorderBrush" Value="#8B1518"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Deconectează" FontWeight="Bold" Foreground="White"/>
                      </Button>
                </StackPanel>

                <Border Width="1" Background="{DynamicResource HairlineBrush}" Margin="8,4,10,4" Height="20"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Command="{Binding StartCommand}" ToolTip="Start măsurare (F5)">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource PrimaryOpButton}">
                            <Setter Property="Background" Value="#1B7A3A"/>
                            <Setter Property="BorderBrush" Value="#0D4F24"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                <Setter Property="Background" Value="#C5CBD2"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                                <Setter Property="Foreground" Value="#5A6573"/>
                              </DataTrigger>
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#C5CBD2"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Start" FontWeight="Bold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="White"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                  <Setter Property="Foreground" Value="#5A6573"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Button>
                      <Button Command="{Binding StopCommand}" ToolTip="Stop măsurare (F6)">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource PrimaryOpButton}">
                            <Setter Property="Background" Value="#E57373"/>
                            <Setter Property="BorderBrush" Value="#8B1518"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                <Setter Property="Background" Value="#C62828"/>
                                <Setter Property="BorderBrush" Value="#8B1518"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Stop" FontWeight="Bold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#B71C1C"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                  <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Button>
                      <Button Command="{Binding StartRecordCommand}" ToolTip="Record CSV (F7)">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource PrimaryOpButton}">
                            <Setter Property="Background" Value="#C62828"/>
                            <Setter Property="BorderBrush" Value="#8B1518"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background" Value="#9B0A1E"/>
                                <Setter Property="BorderBrush" Value="#6A0814"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Rec" FontWeight="Bold" Foreground="White"/>
                      </Button>
                      <Button Style="{StaticResource PrimaryOpButton}" Command="{Binding StopRecordCommand}"
                              Background="#FFEBEE" ToolTip="Stop Record (F8)" MinWidth="56">
                        <TextBlock Text="Stop Rec" FontWeight="SemiBold" FontSize="12"/>
                      </Button>
                      <Button Style="{StaticResource PrimaryOpButton}" Command="{Binding TareAllCommand}"
                              ToolTip="Zero all (F9)">
                        <TextBlock Text="Zero" FontWeight="SemiBold"/>
                      </Button>
                </StackPanel>
              </StackPanel>

              <Expander Header="Unelte — Experiment / Viz / Export / Ajutor" IsExpanded="False"
                        Margin="4,4,0,0" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">

                <Border Style="{StaticResource RibbonGroup}" BorderThickness="0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource RibbonGroupTitle}" Text="EXPERIMENT"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource SecondaryOpButton}" Command="{Binding StartExperimentCommand}"
                              ToolTip="Experiment nou"
                              AutomationProperties.Name="Experiment nou">
                        <TextBlock Text="Nou"/>
                      </Button>
                      <Button Style="{StaticResource SecondaryOpButton}" Command="{Binding CloseExperimentCommand}"
                              ToolTip="Închide experiment">
                        <TextBlock Text="Închide"/>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- DISPOZITIV (secundar) -->
                <Border Style="{StaticResource RibbonGroup}" BorderThickness="0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource RibbonGroupTitle}" Text="DISPOZITIV"/>
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton IsChecked="{Binding DisplayFrozen}" Style="{StaticResource RibbonIconToggle}"
                                    ToolTip="Hold afișaj">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE769;" FontSize="15"/>
                      </ToggleButton>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding RefreshPortsCommand}"
                              ToolTip="Reîmprospătare listă porturi">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding DisconnectCommand}"
                              ToolTip="Deconectare dispozitiv">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE894;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ResetAllSoftZeroCommand}"
                              ToolTip="Șterge Soft Zero pe toate canalele">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding MarkRecordingCommand}"
                              ToolTip="Marcaj CSV în timpul Record. Ctrl+Shift+M">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE735;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding CopyLiveValuesCommand}"
                              ToolTip="Copiază valori live">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ExportLiveValuesCommand}"
                              ToolTip="Export valori live…">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDE1;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding RunMacroCommand}"
                              ToolTip="Rulează macro…">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding VerifySensorCommand}"
                              ToolTip="Verificare senzor pe canalul selectat">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="14"/>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- VIZUALIZARE -->
                <Border Style="{StaticResource RibbonGroup}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource RibbonGroupTitle}" Text="VIZ"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Command="{Binding SetWorkspaceLiveCommand}"
                              ToolTip="Mod Live: măsurare + Y(t). Ctrl+1"
                              local:HelpTip.Text="Mod Live: măsurare + Y(t). Ctrl+1">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource WorkspaceModeButton}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsWorkspaceLive}" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Live"/>
                      </Button>
                      <Button Command="{Binding SetWorkspaceConfigureCommand}"
                              ToolTip="Mod Configure: job, rată, senzori, meta. Ctrl+2"
                              local:HelpTip.Text="Mod Configure: job, rată, senzori, meta. Ctrl+2">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource WorkspaceModeButton}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsWorkspaceConfigure}" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Cfg"/>
                      </Button>
                      <Button Command="{Binding SetWorkspaceReviewCommand}"
                              ToolTip="Mod Review: DataViewer + export. Ctrl+3"
                              local:HelpTip.Text="Mod Review: DataViewer + export. Ctrl+3">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource WorkspaceModeButton}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsWorkspaceReview}" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="Rev"/>
                      </Button>
                      <Border Style="{StaticResource RibbonToolbarSeparator}"/>
                      <ComboBox Style="{StaticResource RibbonFieldCombo}" ItemsSource="{Binding PlotModes}"
                                SelectedItem="{Binding PlotMode}" MinWidth="72"
                                ToolTip="{Binding PlotModeDescription}"
                                local:HelpTip.Text="Mod afișaj Grafic live: Y(t), Dual, Y(X), Poisson (ν), Numeric, Bar, FFT, CWT."/>
                      <ComboBox Style="{StaticResource RibbonFieldCombo}" ItemsSource="{Binding ExperimentPresets}"
                                SelectedItem="{Binding SelectedExperiment}" DisplayMemberPath="Name" MinWidth="100"
                                ToolTip="Preset experiment"/>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ToggleLivePlotCardCommand}"
                              ToolTip="Grafic live — deschide / aduce în față"
                              local:HelpTip.Text="Deschide Grafic live dacă e ascuns; altfel îl aduce în față.">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D2;" FontSize="14"/>
                      </Button>
                      <Button Style="{StaticResource RibbonIconButton}" Command="{Binding ShowGraficMorletCommand}"
                              ToolTip="Grafic Morlet — CWT live"
