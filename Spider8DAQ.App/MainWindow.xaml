                <TextBlock Text="{Binding SensorLibrarySummary}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" FontSize="12"
                         Text="Click dreapta pe un senzor (arbore sau grilă): Apply, Zero/Offset 0, editează, duplică, șterge, copiază, detalii."/>
