                  <Button Content="Apply → CH" Command="{Binding ApplySensorCommand}" Margin="0,0,8,6"/>
                  <Button Style="{StaticResource GhostButton}" Content="Reload" Command="{Binding ReloadSensorsCommand}" Margin="0,0,8,6"/>
                  <Button Style="{StaticResource GhostButton}" Content="Save" Command="{Binding SaveSensorsCommand}" Margin="0,0,8,6"/>
                </WrapPanel>
                <Menu DockPanel.Dock="Right" Style="{StaticResource OverflowMenu}" VerticalAlignment="Center" Margin="0,0,0,6">
                  <MenuItem Header="Bibliotecă ▾" Style="{StaticResource OverflowMenuItem}">
                    <MenuItem Header="Aplică pe toate On" Command="{Binding ApplySensorAllEnabledCommand}"/>
                    <MenuItem Header="Zero / Offset 0" Command="{Binding ZeroSensorOffsetCommand}"/>
                    <Separator/>
                    <MenuItem Header="Import" Command="{Binding ImportSensorsCommand}"/>
                    <MenuItem Header="Export" Command="{Binding ExportSensorsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Adaugă personalizat" Command="{Binding AddSensorCommand}"/>
                    <MenuItem Header="Duplică" Command="{Binding DuplicateSensorCommand}"/>
                    <MenuItem Header="Șterge" Command="{Binding DeleteSensorCommand}"/>
