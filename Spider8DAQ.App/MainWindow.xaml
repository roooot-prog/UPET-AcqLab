                          BorderBrush="{Binding FingerprintStatusBrush}" BorderThickness="1.5"
                          Visibility="{Binding HasMeasurementFingerprint, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Copiază" Command="{Binding CopyMeasurementFingerprintCommand}"
                              Style="{StaticResource GhostButton}" Padding="8,2" FontSize="11"
                              ToolTip="Copiază amprenta de măsurare"/>
                      <StackPanel>
                        <TextBlock Text="Amprentă de măsurare" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding MeasurementFingerprint}" FontFamily="Consolas" FontSize="13"
                                   FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding FingerprintStatusText}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{Binding FingerprintStatusBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <TextBlock Text="{Binding MatestCompareSummary}" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                  <Border Margin="0,10,0,0" Padding="8" Background="#E8EEF4"
                          Visibility="{Binding HasAnyMontagePhoto, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                      <TextBlock Text="Montaj — înainte / după" FontWeight="SemiBold" Margin="0,0,0,6"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding HasMontagePhoto, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="ÎNAINTE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                          <Image Source="{Binding MontageBeforeImage}" MaxHeight="150" Stretch="Uniform"
                                 Margin="0,4,0,0" HorizontalAlignment="Left"
                                 ToolTip="{Binding MontagePhotoPath}"/>
                          <TextBlock Text="{Binding MontageBeforeNotes}" TextWrapping="Wrap" FontSize="11"
                                     Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                                     Visibility="{Binding HasMontageBeforeNotes, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding HasMontagePhotoAfter, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="DUPĂ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                          <Image Source="{Binding MontageAfterImage}" MaxHeight="150" Stretch="Uniform"
                                 Margin="0,4,0,0" HorizontalAlignment="Left"
                                 ToolTip="{Binding MontagePhotoAfterPath}"/>
                          <TextBlock Text="{Binding MontageAfterNotes}" TextWrapping="Wrap" FontSize="11"
                                     Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                                     Visibility="{Binding HasMontageAfterNotes, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding DeltaText}" Margin="0,4,0,0" FontWeight="SemiBold"
                             FontFamily="{StaticResource MeasureMonoFont}" FontSize="12"/>
                  <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="CursorA" VerticalAlignment="Center"/><TextBox Text="{Binding CursorA}" Width="60"/>
                    <TextBlock Text="CursorB" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox Text="{Binding CursorB}" Width="60"/>
                    <TextBlock Text="CH" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox Text="{Binding AnalysisChannel}" Width="40"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,8,0,0">
                    <TextBox Text="{Binding SmoothWindow}" Width="50"/><Button Content="Smooth" Command="{Binding SmoothAnalysisCommand}"/>
                    <TextBox Text="{Binding CutStart}" Width="50"/><TextBox Text="{Binding CutEnd}" Width="50"/><Button Content="Cut" Command="{Binding CutAnalysisCommand}"/>
                    <Button Content="Peaks" Command="{Binding FindPeaksCommand}"/>
                  </WrapPanel>
                  <TextBlock Text="Operații curbă" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <WrapPanel>
                    <Button Content="∫ Integral" Command="{Binding IntegrateAnalysisCommand}"/>
                    <Button Content="d/dt" Command="{Binding DifferentiateAnalysisCommand}"/>
                    <Button Content="Outliers" Command="{Binding OutlierAnalysisCommand}"/>
                    <Button Content="LPF" Command="{Binding LowPassAnalysisCommand}"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="Scale" VerticalAlignment="Center"/><TextBox Text="{Binding AnalysisScale}" Width="50"/>
                    <TextBlock Text="Off" VerticalAlignment="Center" Margin="6,0,0,0"/><TextBox Text="{Binding AnalysisOffset}" Width="50"/>
                    <Button Content="Apply" Command="{Binding ScaleOffsetAnalysisCommand}"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="Fit X" VerticalAlignment="Center"/><TextBox Text="{Binding FitXChannel}" Width="36"/>
                    <TextBlock Text="Y" VerticalAlignment="Center" Margin="6,0,0,0"/><TextBox Text="{Binding FitYChannel}" Width="36"/>
                    <Button Content="Fit Y(X)" Command="{Binding FitXyAnalysisCommand}"/>
                    <Button Content="Poly2" Command="{Binding FitPoly2AnalysisCommand}"
                            ToolTip="Fit polinomial grad 2 Y(X)"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding FitResultText}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"/>
                  <TextBlock Text="Poisson ν aparent" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <WrapPanel>
                    <TextBlock Text="ε_l CH" VerticalAlignment="Center" ToolTip="Longitudinal (1-based)"/>
                    <TextBox Text="{Binding PoissonEpsLChannel}" Width="36" Margin="4,0,8,0"/>
                    <TextBlock Text="ε_t CH" VerticalAlignment="Center" ToolTip="Transversal (1-based)"/>
                    <TextBox Text="{Binding PoissonEpsTChannel}" Width="36" Margin="4,0,8,0"/>
