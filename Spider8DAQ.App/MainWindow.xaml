              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"
                         Text="Înregistrările CSV sunt în %LocalAppData%\UPETAcqLab\recordings (nu în Program Files). Folosiți «Descarcă CSV» sau «Deschide folder»."/>
              <TextBlock Text="{Binding RecordingsFolderPath}" FontFamily="Consolas" FontSize="12"
